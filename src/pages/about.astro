---
import Base from '../layouts/Base.astro';
import Shot from '../components/Shot.astro';
import NeedsInput from '../components/NeedsInput.astro';
import BendRule from '../components/BendRule.astro';
import { business, phone, pricing, terms } from '../config/site';
---

<Base
  title="About M1 Off-Road — Mike Sulger, Tucson Fabricator"
  description="M1 Off-Road is Mike Sulger's fabrication shop in Tucson, Arizona. Over ten years building roll cages, doors and roofs for UTVs. MIG welding done in house."
>
  <section class="bg-shop text-bone">
    <!-- Text first, shop second. There is deliberately no portrait on this
         page: the work is the subject. -->
    <div
      class="mx-auto grid max-w-6xl items-center gap-10 px-5 py-14 sm:px-8 sm:py-20 lg:grid-cols-2 lg:gap-16"
    >
      <div>
        <BendRule dark class="mb-8 max-w-[8rem]" />
        <h1 class="max-w-[18ch] text-[clamp(2.25rem,6vw,4rem)] font-extrabold">
          {business.owner} has been doing this {business.yearsInBusiness}
        </h1>
        <p class="text-steel mt-6 max-w-[48ch] text-lg sm:text-xl">
          M1 Off-Road is a custom fabrication shop in {business.city},{' '}
          {business.stateCode}, geared to off-road vehicles. Cages, doors and
          roofs, mostly for UTVs.
        </p>
      </div>

      <Shot shot="shop-wide" class="w-full" />
    </div>
  </section>

  <section class="bg-bone">
    <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-24">
      <div class="grid gap-12 lg:grid-cols-[1fr_minmax(0,24rem)] lg:gap-16">
        <div class="max-w-[58ch]">
          <h2 class="text-[clamp(1.875rem,4.5vw,3rem)]">How the shop works</h2>

          <div class="text-slate mt-6 space-y-5 text-lg">
            <p>
              Mike quotes the job, builds it and welds it. You deal with him
              directly.
            </p>
            <p>
              Most of what comes through is a Polaris RZR or a Can-Am, so the
              fit-up on those is well practised. Kawasaki Teryx and other
              machines have been built for too.
            </p>

            <h3 class="text-shop pt-4 text-2xl">What is done here, and what is not</h3>
            <p>
              All welding is MIG and done in this shop. Powder coating is not
              done here; it goes out to a coater.
            </p>
            <p>
              A typical full cage is {pricing.cageStartingAtDisplay}. The price
              is on the front page so you do not have to call to find it out.
            </p>

            <h3 class="text-shop pt-4 text-2xl">Getting a job booked</h3>
            <p>
              Call with the year, make, model, and what you want done. {
                business.hours.short
              }.
            </p>
          </div>
        </div>

        <aside class="space-y-4">
          <!-- A closer frame than the masthead shot, not a second view of the
               same thing: the nodes where the tubes actually meet. -->
          <Shot shot="cage-joint" light class="w-full" />

          <Shot shot="badge" light class="w-full" />

          <div class="border-bone-line bend border p-6">
            <h2 class="text-xl">The short version</h2>
            <dl class="mt-4 space-y-3 text-[0.9375rem]">
              <div>
                <dt class="text-slate">Owner</dt>
                <dd class="font-semibold">{business.owner}</dd>
              </div>
              <div>
                <dt class="text-slate">Shop</dt>
                <dd class="font-semibold">
                  {business.city}, {business.stateCode}
                </dd>
              </div>
              <div>
                <dt class="text-slate">In business</dt>
                <dd class="font-semibold">
                  {business.yearsInBusiness.replace(/^over/, 'Over')}
                </dd>
              </div>
              <div>
                <dt class="text-slate">Welding</dt>
                <dd class="font-semibold">MIG, in house</dd>
              </div>
              <div>
                <dt class="text-slate">Powder coating</dt>
                <dd class="font-semibold">Sent out</dd>
              </div>
              <div>
                <dt class="text-slate">Full cage from</dt>
                <dd class="font-semibold">{pricing.cageStartingAtDisplay}</dd>
              </div>
              <div>
                <dt class="text-slate">Everything else</dt>
                <dd class="font-semibold">{terms.servicePricing}</dd>
              </div>
              <div>
                <dt class="text-slate">Time in the shop</dt>
                <dd class="font-semibold">{terms.leadTime}</dd>
              </div>
              <div>
                <dt class="text-slate">Address</dt>
                <dd class="font-semibold">{business.address.oneLine}</dd>
              </div>
              <div>
                <dt class="text-slate">Hours</dt>
                <dd class="font-semibold">{business.hours.short}</dd>
              </div>
            </dl>
            <a
              href={phone.tel}
              data-analytics="call-about"
              class="font-display bg-shop bend border border-shop mt-6 block px-5 py-3 text-center font-bold text-bone transition-colors hover:bg-transparent hover:text-shop"
            >
              {phone.display}
            </a>
          </div>
        </aside>
      </div>
    </div>
  </section>
</Base>
