---
import Base from '../layouts/Base.astro';
import QuoteForm from '../components/QuoteForm.astro';
import BendRule from '../components/BendRule.astro';
import { business, phone, pricing, terms } from '../config/site';
---

<Base
  title="Contact M1 Off-Road — Tucson UTV Fabrication | (520) 403-3366"
  description="Call or text M1 Off-Road in Tucson at (520) 403-3366, or send your year, make and model for a quote on a roll cage, doors, a roof or custom fabrication."
>
  <section class="bg-shop text-bone">
    <div class="mx-auto max-w-6xl px-5 py-14 sm:px-8 sm:py-20">
      <BendRule dark class="mb-8 max-w-[8rem]" />
      <h1 class="max-w-[16ch] text-[clamp(2.25rem,6vw,4rem)] font-extrabold">
        Call, text, or send the details
      </h1>
      <p class="text-steel mt-6 max-w-[48ch] text-lg sm:text-xl">
        The fastest way to find out what something costs is to call. Year, make
        and model is enough to start.
      </p>

      <div class="mt-9 flex flex-col gap-3 sm:flex-row">
        <a
          href={phone.tel}
          data-analytics="call-contact"
          class="font-display bg-bone text-shop bend border border-bone hover:bg-transparent hover:text-bone px-7 py-4 text-center text-lg font-bold transition-colors"
        >
          Call {phone.display}
        </a>
        <a
          href={phone.sms}
          data-analytics="text-contact"
          class="font-display border-steel/50 bend hover:border-bone border px-7 py-4 text-center text-lg font-bold transition-colors"
        >
          Text {phone.display}
        </a>
      </div>
    </div>
  </section>

  <section class="bg-bone">
    <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-24">
      <div class="grid gap-12 lg:grid-cols-[1fr_minmax(0,22rem)] lg:gap-16">
        <div>
          <h2 class="text-[clamp(1.875rem,4.5vw,3rem)]">Ask for a quote</h2>
          <p class="text-slate mt-4 max-w-[52ch] text-lg">
            Five things, and one of them is optional. It goes straight to Mike,
            who will call you back on the number you leave.
          </p>

          <QuoteForm />
        </div>

        <aside class="space-y-4">
          <div class="border-bone-line bend border p-6">
            <h2 class="text-xl">The shop</h2>
            <dl class="mt-4 space-y-4 text-[0.9375rem]">
              <div>
                <dt class="text-slate">Phone</dt>
                <dd class="font-display mt-0.5 text-xl font-bold">
                  <a
                    href={phone.tel}
                    data-analytics="call-contact-aside"
                    class="hover:text-slate transition-colors">{phone.display}</a
                  >
                </dd>
              </div>
              <div>
                <dt class="text-slate">Text</dt>
                <dd class="mt-0.5 font-semibold">
                  <a
                    href={phone.sms}
                    data-analytics="text-contact-aside"
                    class="hover:text-slate transition-colors"
                    >Same number</a
                  >
                </dd>
              </div>
              <div>
                <dt class="text-slate">Owner</dt>
                <dd class="mt-0.5 font-semibold">{business.owner}</dd>
              </div>
              <div>
                <dt class="text-slate">City</dt>
                <dd class="mt-0.5 font-semibold">
                  {business.city}, {business.stateCode}
                </dd>
              </div>
              <div>
                <dt class="text-slate">Address</dt>
                <dd class="mt-0.5 font-semibold">
                  <a
                    href={business.address.mapUrl}
                    rel="noopener"
                    class="hover:text-slate underline decoration-1 underline-offset-4 transition-colors"
                  >
                    {business.address.street}<br />
                    {business.address.locality}, {business.address.region}{' '}
                    {business.address.postalCode}
                  </a>
                </dd>
              </div>
              <div>
                <dt class="text-slate">Hours</dt>
                <dd class="mt-0.5 font-semibold">{business.hours.display}</dd>
              </div>
            </dl>
          </div>

          <div class="bg-shop text-bone bend p-6">
            <h2 class="text-xl">Before you ask</h2>
            <p class="text-steel mt-3 text-[0.9375rem]">
              A typical full cage runs {pricing.cageStartingAtDisplay}. Doors,
              roofs and custom work are {terms.servicePricing.toLowerCase()}.
            </p>
            <p class="text-steel mt-3 text-[0.9375rem]">
              {terms.leadTime} for time in the shop.
            </p>
            <p class="text-steel mt-3 text-[0.9375rem]">
              All welding is MIG and done in house. Powder coating is sent out.
            </p>
          </div>
        </aside>
      </div>
    </div>
  </section>
</Base>
