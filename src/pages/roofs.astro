---
import ServiceLayout from '../layouts/ServiceLayout.astro';
import Placeholder from '../components/Placeholder.astro';
import BendRule from '../components/BendRule.astro';
import { terms } from '../config/site';
---

<ServiceLayout
  slug="roofs"
  title="Custom UTV Roofs — Tucson Fabrication | M1 Off-Road"
  description="Custom roofs for Polaris RZR, Can-Am and other UTVs, built to the cage and MIG welded in Tucson. Shade that does not drum, rattle or peel off at speed."
  headline="A roof built to the cage, not bolted over it"
  lede="In Tucson the roof is not an accessory. It is built to the cage it sits on, so it stays put and stays quiet."
  heroShot="svc-roofs"
>
  <section class="bg-bone">
    <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-24">
      <BendRule class="mb-8 max-w-xs" />
      <div class="grid gap-10 lg:grid-cols-[1fr_minmax(0,24rem)] lg:gap-16">
        <div>
          <h2 class="max-w-[20ch] text-[clamp(1.875rem,4.5vw,3rem)]">
            Shade is not optional here
          </h2>
          <div class="text-slate mt-6 max-w-[56ch] space-y-4 text-lg">
            <p>
              A bolt-on roof sits on top of whatever it can reach and drums the
              whole way home. One built to the cage picks up the tube where the
              tube actually runs, which is why it does not buzz and does not
              work its fasteners loose over a season.
            </p>
            <p>
              Roofs go on with a cage or onto a cage already built. If the cage
              came from here, the fit is already known.
            </p>
          </div>

          <dl class="border-bone-line mt-10 grid gap-px border-t">
            <div class="border-bone-line grid gap-1 border-b py-4 sm:grid-cols-[14rem_1fr]">
              <dt class="font-semibold">Welding</dt>
              <dd class="text-slate">MIG, done in house.</dd>
            </div>
            <div class="border-bone-line grid gap-1 border-b py-4 sm:grid-cols-[14rem_1fr]">
              <dt class="font-semibold">Finish</dt>
              <dd class="text-slate">Powder coating is sent out to a coater.</dd>
            </div>
            <div class="border-bone-line grid gap-1 border-b py-4 sm:grid-cols-[14rem_1fr]">
              <dt class="font-semibold">Price</dt>
              <dd class="text-slate">
                {terms.servicePricing} — it depends on the cage underneath it.
              </dd>
            </div>
            <div class="border-bone-line grid gap-1 border-b py-4 sm:grid-cols-[14rem_1fr]">
              <dt class="font-semibold">Time in the shop</dt>
              <dd class="text-slate">{terms.leadTime}.</dd>
            </div>
          </dl>
        </div>

        <Placeholder shot="roof-edge" light class="w-full" />
      </div>
    </div>
  </section>
</ServiceLayout>
