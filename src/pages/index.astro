---
import Base from '../layouts/Base.astro';
import Shot from '../components/Shot.astro';
import GalleryTile from '../components/GalleryTile.astro';
import NeedsInput from '../components/NeedsInput.astro';
import BendRule from '../components/BendRule.astro';
import {
  business,
  phone,
  pricing,
  services,
  platforms,
  terms,
} from '../config/site';
import { gallery } from '../config/gallery';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { shots } from '../config/shots';

/* Home is the only page carrying the LocalBusiness block, so the markup
   describes one business rather than eight. */

/* ---------------------------------------------------------
   The hero is generated here rather than through <Shot>, because it is the
   LCP element and has to be preloaded. Building the variants once and using
   the same list for BOTH the preload link and the <img> guarantees they
   match — a preload that misses by one URL downloads the image twice and is
   worse than no preload at all.
   --------------------------------------------------------- */
const heroShot = shots['hero-build'];
const photoFiles = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/photos/*.{jpg,jpeg,png,webp,avif}',
  { eager: true }
);
const heroSource = heroShot.file
  ? photoFiles[`../assets/photos/${heroShot.file}`]?.default
  : undefined;

/* Two sources, art-directed — and deliberately two different photographs.

   A hero box is wide; the night dune shot is portrait and its machine runs off
   the left edge of the original frame, so on a desktop screen it could never
   show a whole machine no matter how it was cropped. It is also only 1536px
   across, which meant upscaling on any retina display. On a phone it is
   perfect: portrait fills the screen with nothing cropped, and it carries the
   shop's own number panel.

   So the phone keeps it, and wide screens get a machine photographed side-on
   in daylight at 2048px with every corner of it in frame. */
/* Widths stop at the source's own width. Asking for 1920 or 2560 from a
   1536-wide file makes Astro upscale and re-encode, which is softer than
   letting the browser scale the native file. That upscaling was the actual
   cause of the soft hero, not the compression, so quality sits at 80: 86 cost
   ~0.4s of LCP for a difference that is not visible at these sizes. */
const buildSrcset = async (src: ImageMetadata | undefined) => {
  if (!src) return '';
  const widths = [640, 960, 1280, 1600, 2048].filter((w) => w <= src.width);
  if (!widths.includes(src.width)) widths.push(src.width);
  const made = await Promise.all(
    widths.map((width) => getImage({ src, width, format: 'webp', quality: 80 }))
  );
  return made.map((v, i) => `${v.src} ${widths[i]}w`).join(', ');
};

/* Desktop hero: the red Pro R, 2048px wide, whole machine in frame with real
   margin on all four sides — which is the part that matters. A photograph
   whose subject touches the edges has no background left to give, so a wide
   box crops the machine itself; this one can be trimmed at any window shape
   and still lose only desert. The bare steel cage is the point: it is the
   actual tube work, unpainted, which is what the shop sells.

   The night dune shot stays on phones. Portrait fills a phone screen with
   nothing cropped and it carries the shop's own number panel, but it cannot do
   the same job wide: its machine runs off the left edge of the original frame,
   so no crop shows the whole of it, and at 1536px across it was upscaled
   roughly 1.9x on a retina display. That was the blur. */
const heroWideSource = photoFiles['../assets/photos/hero-rzr-red-wide.jpg']?.default;

const heroSrcset = await buildSrcset(heroSource);
const heroWideSrcset = await buildSrcset(heroWideSource);
/* A <picture> has one alt for every <source>, and these two sources are
   different machines. So the alt describes what is true of both rather than
   naming a colour a desktop visitor cannot see or a phone visitor can. */
const heroAlt =
  'A four-seat UTV fitted with a custom M1 Off-Road roll cage.';

/* Matches the <source media> below, so the preload picks the same file the
   browser will actually use. */
const HERO_WIDE_MEDIA = '(min-width: 640px)';

/* Six tiles for the teaser strip, taken one at a time across the platforms so
   the row is not six near-identical RZRs. */
const teaser = [
  gallery['polaris-rzr'][0],
  gallery['can-am'][0],
  gallery['kawasaki'][0],
  gallery['polaris-rzr'][10],
  gallery['in-the-shop'][0],
  gallery['polaris-rzr'][4],
];
---

<Base
  title="M1 Off-Road — Custom UTV Roll Cages, Doors & Roofs in Tucson"
  description="Custom roll cages, doors and roofs for Polaris RZR, Can-Am and other UTVs. MIG welded in Tucson by Mike Sulger. Full cages start at $2,500. Call (520) 403-3366."
  schema
  preloadImage={heroWideSrcset ? { srcset: heroWideSrcset, sizes: '100vw', media: HERO_WIDE_MEDIA } : undefined}
>
  <!-- ==========================================================
       HERO — the one place on this site that raises its voice.
       Everything below it is deliberately quiet.
       ========================================================== -->
  <section class="bg-shop text-bone relative overflow-hidden">
    <!-- The photograph lives in its own absolutely positioned wrapper rather
         than being stretched directly against this section.

         An <img> sized with height:100% needs a containing block with a
         DEFINITE height. This container gets its height from min-height plus
         content, which Firefox resolves to auto — so the image fell back to
         its intrinsic height and left the bottom of the hero uncovered. The
         wrapper takes a definite height from inset-0, so the image fills it
         in every engine. -->
    <div class="absolute inset-0">
      {
        heroSource ? (
          <picture>
            {heroWideSrcset && (
              <source
                media={HERO_WIDE_MEDIA}
                srcset={heroWideSrcset}
                sizes="100vw"
                width="2048"
                height="1280"
              />
            )}
            <img
              srcset={heroSrcset}
              sizes="100vw"
              alt={heroAlt}
              width={heroSource.width}
              height={heroSource.height}
              loading="eager"
              fetchpriority="high"
              decoding="sync"
              class="h-full w-full object-cover"
              /* Near-centred now that both sources carry margin around the
                 machine: a trim at either edge takes sky or ground, not the
                 cage or the tyres. */
              style="object-position:50% 62%"
            />
          </picture>
        ) : (
          <Shot shot="hero-build" fill eager sizes="100vw" />
        )
      }

      <!-- Two scrims, one per crop, because one curve cannot serve both.

           The portrait source makes a taller hero, so the subhead sits higher
           up the gradient than it does on the wide crop — measured at 0.49
           alpha on a phone against 0.81 on desktop, which put the worst pixel
           behind that line at 3.08:1. The desktop curve is already clearing
           12:1 and darkening it further would only bury the machine, so the
           phone gets its own steeper curve instead of both sharing a
           compromise. -->
      <div
        class="absolute inset-0 sm:hidden"
        style="background:linear-gradient(to top, rgb(17 17 17 / .94) 0%, rgb(17 17 17 / .88) 35%, rgb(17 17 17 / .80) 60%, rgb(17 17 17 / .38) 82%, rgb(17 17 17 / .06) 100%)"
        aria-hidden="true"
      >
      </div>
      <div
        class="absolute inset-0 hidden sm:block"
        style="background:linear-gradient(to top, rgb(17 17 17 / .88) 0%, rgb(17 17 17 / .76) 30%, rgb(17 17 17 / .52) 55%, rgb(17 17 17 / .16) 78%, rgb(17 17 17 / 0) 100%)"
        aria-hidden="true"
      >
      </div>
    </div>

    <!-- A FULL-WIDTH sizer sets the hero height from the VIEWPORT width, so the
         box stays close to the photograph's own ratio instead of holding one
         height while the width runs away. Putting this on the max-w-6xl content
         block instead froze the height at 1152/1.6 = 720px and let the crop
         creep back in on wide monitors.

         min-height rather than aspect-ratio, because aspect-ratio is a fixed
         height: when the headline, price and two stacked buttons are taller
         than it on a phone, the text overflows the hero onto the section below.
         133vw is 3:4 and 62.5vw is 16:10 — the same proportions, but the box
         can grow when the content needs it to. -->
    <div
      class="relative flex min-h-[max(32rem,min(133vw,80vh))] items-end sm:min-h-[max(28rem,min(66.6vw,88vh,52rem))] lg:min-h-[max(28rem,min(66.6vw,92vh,62rem))]"
    >
      <div class="mx-auto w-full max-w-6xl px-5 py-14 sm:px-8 sm:py-16">
      <h1
        class="max-w-[15ch] text-[clamp(2.375rem,7.5vw,4.5rem)] font-extrabold tracking-[-0.03em]"
      >
        Custom roll cages, doors and roofs.
      </h1>

      <!-- text-bone, not text-steel. The documented 5.8:1 for steel holds
           against solid #111; this line sits where the scrim is thinnest, over
           the brightest part of the photograph, where that figure does not
           apply. It also now carries the two facts that decide a local trade
           call — tenure, and that one person does the work — which were
           previously only on /about/ and in the fifth paragraph of the price
           column. -->
      <p class="text-bone mt-5 max-w-[44ch] text-lg sm:text-xl">
        Built for UTVs in {business.city} by {business.owner}. {
          business.yearsInBusiness.replace(/^over/, 'Over')
        } of it, and he welds every one himself.
      </p>

      <!-- The price sits on its own rule rather than inside the paragraph.
           Most shops make you call to find it out; putting it here is the
           single most useful thing on the page. -->
      <p
        class="border-steel/40 font-display mt-7 border-t pt-5 text-xl font-bold sm:text-2xl"
      >
        Full cages from {pricing.cageStartingAtDisplay}
      </p>

      <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:items-center">
        <a
          href={phone.tel}
          data-analytics="call-hero"
          class="font-display bg-bone text-shop bend border border-bone hover:bg-transparent hover:text-bone px-7 py-4 text-center text-lg font-bold transition-colors"
        >
          Call {phone.display}
        </a>
        <a
          href="/contact/"
          class="font-display border-steel/50 text-bone bend hover:border-bone border px-7 py-4 text-center text-lg font-bold transition-colors"
        >
          Get a quote
        </a>
        </div>

        <!-- Hours next to the call, not only in the footer. Someone deciding
             to ring a one-man shop needs to know whether anybody will pick up. -->
        <p class="text-bone/75 mt-4 text-[0.9375rem]">
          {business.hours.display}
        </p>
      </div>
    </div>
  </section>

  <!-- ==========================================================
       WHAT HE BUILDS
       One photo and a plain list. The detail lives on /services/.
       ========================================================== -->
  <section class="bg-bone">
    <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-24">
      <BendRule class="mb-8 max-w-xs" />

      <h2 class="max-w-[16ch] text-[clamp(2rem,5vw,3.25rem)]">
        What comes out of the shop
      </h2>

      <!-- One photo and a list, not four photo cards. Each service keeps its
           own heading and anchor on /services/; repeating all four here as
           cards was the single busiest thing on the page. -->
      <div class="mt-12 grid gap-10 lg:grid-cols-2 lg:gap-16">
        <Shot shot="bend-bare" light class="w-full" />

        <div>
          <ul class="border-bone-line border-t">
            {services.map((s) => (
              <li class="border-bone-line border-b">
                <a
                  href={`/services/#${s.slug}`}
                  class="hover:text-slate flex flex-col gap-1.5 py-5 transition-colors"
                >
                  <span class="flex items-baseline justify-between gap-4">
                    <span class="font-display text-xl font-bold">{s.title}</span>
                    {s.startingAt && (
                      <span class="font-display shrink-0 text-lg font-bold">
                        From {s.startingAt}
                      </span>
                    )}
                  </span>
                  <span class="text-slate max-w-[44ch]">{s.blurb}</span>
                </a>
              </li>
            ))}
          </ul>

          <a
            href="/services/"
            class="text-shop mt-6 inline-block font-semibold underline decoration-1 underline-offset-4"
          >
            What goes into each of these
          </a>
        </div>
      </div>
      <p class="text-slate mt-10 max-w-[62ch] text-lg">
        All welding is MIG and done in house. Powder coating is sent out to a
        coater.
      </p>
    </div>
  </section>

  <!-- ==========================================================
       PRICE
       Not knowing what a cage costs is what stops people calling,
       so the number gets a section to itself.
       ========================================================== -->
  <section class="bg-shop text-bone">
    <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-24">
      <div class="grid gap-10 lg:grid-cols-[auto_1fr] lg:gap-16">
        <div>
          <p class="text-steel text-lg">A typical full cage runs</p>
          <p
            class="font-display text-bone mt-1 text-[clamp(4rem,14vw,8rem)] leading-[0.85] font-extrabold tracking-[-0.04em]"
          >
            {pricing.cageStartingAtDisplay}
          </p>
        </div>

        <div class="max-w-[52ch] space-y-5 text-lg">
          <p>
            The price depends on the machine, the seat count, and what else gets
            built while it is apart: doors, a roof, mounts.
          </p>
          <p class="text-steel">
            Call with the year, make and model and you will get a number on the
            phone. You do not need an appointment to ask what something costs.
          </p>
          <p class="text-steel">
            Doors, roofs and custom work are {terms.servicePricing.toLowerCase()}.
            Either way you are not without the machine long — {terms.leadTime.toLowerCase()}.
          </p>
          <p>
            Mike quotes the job and Mike welds it — <a
              href="/about/"
              class="font-semibold underline decoration-1 underline-offset-4"
              >more about the shop</a
            >.
          </p>
          <div class="flex flex-col gap-3 pt-2 sm:flex-row">
            <a
              href={phone.tel}
              data-analytics="call-price"
              class="font-display bg-bone text-shop bend border border-bone hover:bg-transparent hover:text-bone px-6 py-3.5 text-center font-bold transition-colors"
            >
              Call {phone.display}
            </a>
            <a
              href="/contact/"
              class="font-display border-steel/50 bend hover:border-bone border px-6 py-3.5 text-center font-bold transition-colors"
            >
              Send the details
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==========================================================
       GALLERY TEASER — dense, square, no gaps. The camera-roll grid.
       ========================================================== -->
  <section class="bg-bone">
    <div class="mx-auto max-w-6xl px-5 pt-16 sm:px-8 sm:pt-24">
      <BendRule class="mb-8 max-w-xs" />
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <h2 class="text-[clamp(2rem,5vw,3.25rem)]">Machines that have been through</h2>
        <a
          href="/gallery/"
          class="text-shop font-semibold underline decoration-1 underline-offset-4"
        >
          See the full gallery
        </a>
      </div>
      <p class="text-slate mt-4 max-w-[52ch] text-lg">
        {platforms.map((p) => p.name).join(', ')} — and plenty that do not fit a
        category.
      </p>
    </div>

    <!-- Full-bleed, gutterless, square. This is the one dense thing on the
         page and it is meant to read as a wall of work. -->
    <div class="mt-10 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6">
      {teaser.map((photo) => <GalleryTile photo={photo} href="/gallery/" />)}
    </div>
  </section>

  <!-- ==========================================================
       CLOSING CTA
       ========================================================== -->
  <section class="bg-shop text-bone">
    <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-20">
      <h2 class="max-w-[20ch] text-[clamp(2rem,5vw,3.25rem)]">
        Tell me the machine and what you want done.
      </h2>
      <p class="text-steel mt-5 max-w-[48ch] text-lg">
        Year, make and model is enough to start. Photos help if you have them.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a
          href={phone.tel}
          data-analytics="call-closing"
          class="font-display bg-bone text-shop bend border border-bone hover:bg-transparent hover:text-bone px-7 py-4 text-center text-lg font-bold transition-colors"
        >
          Call {phone.display}
        </a>
        <a
          href={phone.sms}
          data-analytics="text-closing"
          class="font-display border-steel/50 bend hover:border-bone border px-7 py-4 text-center text-lg font-bold transition-colors"
        >
          Send a text
        </a>
      </div>
    </div>
  </section>
</Base>
