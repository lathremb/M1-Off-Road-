---
import Base from '../layouts/Base.astro';
import Shot from '../components/Shot.astro';
import GalleryTile from '../components/GalleryTile.astro';
import NeedsInput from '../components/NeedsInput.astro';
import BendRule from '../components/BendRule.astro';
import {
  business,
  phone,
  pricing,
  services,
  platforms,
  terms,
} from '../config/site';
import { gallery } from '../config/gallery';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { shots } from '../config/shots';

/* Home is the only page carrying the LocalBusiness block, so the markup
   describes one business rather than eight. */

/* ---------------------------------------------------------
   The hero is generated here rather than through <Shot>, because it is the
   LCP element and has to be preloaded. Building the variants once and using
   the same list for BOTH the preload link and the <img> guarantees they
   match — a preload that misses by one URL downloads the image twice and is
   worse than no preload at all.
   --------------------------------------------------------- */
const heroShot = shots['hero-build'];
const photoFiles = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/photos/*.{jpg,jpeg,png,webp,avif}',
  { eager: true }
);
const heroSource = heroShot.file
  ? photoFiles[`../assets/photos/${heroShot.file}`]?.default
  : undefined;

/* Widths stop at the source's own width. Asking for 1920 or 2560 from a
   1536-wide file makes Astro upscale and re-encode, which is softer than
   letting the browser scale the native file. That upscaling was the actual
   cause of the soft hero, not the compression, so quality sits at 80: 86 cost
   ~0.4s of LCP for a difference that is not visible at these sizes. */
const buildSrcset = async (src: ImageMetadata | undefined) => {
  if (!src) return '';
  const widths = [640, 960, 1280, 1600, 2048].filter((w) => w <= src.width);
  if (!widths.includes(src.width)) widths.push(src.width);
  const made = await Promise.all(
    widths.map((width) => getImage({ src, width, format: 'webp', quality: 80 }))
  );
  return made.map((v, i) => `${v.src} ${widths[i]}w`).join(', ');
};

/* ONE photograph, one slot, no art direction.

   The hero used to carry two different machines: the portrait night shot on
   phones and a landscape daylight shot on wide screens. That split existed
   for one reason — a full-bleed wide hero cannot use a 1536px portrait file
   without upscaling it, and on a retina display that upscale was about 1.9x.
   It was the blur.

   The answer was never a second photograph. It was to stop asking a portrait
   file to fill a landscape box. This layout gives the picture a TALL panel,
   which is the shape the file already is, so one source covers every
   breakpoint and nothing is upscaled anywhere: the panel is capped at 34rem,
   so even at 2x it asks for 1088px of a 1536px original.

   Measured across all 35 photographs in the library, this one is the darkest
   by a wide margin — mean luminance 64 against 95 for the next and 108 for
   the daylight shot it replaces. That is not a coincidence of exposure; it is
   the only night frame in the set, and the dark is what was wanted.

   Dropping the second source also gives the alt text back. With two machines
   it had to describe what was true of both; with one it can describe the
   actual photograph, which is what a screen reader should hear. */
const heroSrcset = await buildSrcset(heroSource);
const heroAlt = heroShot.alt;

/* The panel is 34rem from lg up and full width below it. */
const HERO_SIZES = '(min-width: 64rem) 34rem, 100vw';

/* Six tiles for the teaser strip, taken one at a time across the platforms so
   the row is not six near-identical RZRs. */
const teaser = [
  gallery['polaris-rzr'][0],
  gallery['can-am'][0],
  gallery['kawasaki'][0],
  gallery['polaris-rzr'][10],
  gallery['in-the-shop'][0],
  gallery['polaris-rzr'][4],
];
---

<Base
  title="M1 Off-Road | Custom UTV Roll Cages & Fabrication Tucson, AZ"
  description="Custom roll cages, doors, roofs and bumpers for Polaris RZR, Can-Am and other SxS machines. MIG welded in Tucson, AZ. Full cages from $2,500."
  schema
  preloadImage={heroSrcset ? { srcset: heroSrcset, sizes: HERO_SIZES } : undefined}
>
  <!-- ==========================================================
       HERO — a black type field beside a tall photograph.

       The previous two heroes both put the words on top of the picture:
       first directly, then on a plate laid over it. Both were fighting the
       same thing — the background behind the text is a photograph, and a
       photograph is different at every window size.

       This one stops overlapping them. The type sits on flat shop black and
       the photograph gets a panel of its own, which buys three things at
       once. Contrast becomes a non-question: the ground is #111 everywhere,
       so there is no scrim anywhere on this page any more. The photograph is
       never dimmed, because nothing has to be read through it. And the panel
       is TALL, which is the shape this file actually is — so the night shot
       finally runs at native resolution instead of being stretched across a
       wide box.
       ========================================================== -->
  <section class="bg-shop text-bone">
    <!-- The left padding aligns the headline with every section below it.

         `100%` here resolves against the section, which is the real available
         width — unlike `100vw`, which includes the scrollbar and would leave
         the hero about 8px out of step with the rest of the page on Windows.
         72rem is max-w-6xl and 2rem is the sm gutter, so this reproduces
         exactly where `mx-auto max-w-6xl px-8` starts, and the max() floor
         takes over once the viewport is narrower than the container. -->
    <div
      class="grid lg:min-h-[min(40rem,82vh)] lg:grid-cols-[1fr_minmax(0,34rem)] lg:pl-[max(2rem,calc((100%-72rem)/2+2rem))]"
    >
      <!-- The photograph is first in the document and moves to the right
           column from lg up. Source order is the phone order, so a screen
           reader hears the machine described before the sentence about it,
           which is also what a sighted visitor on a phone sees. -->
      <div
        /* Square below lg, not 4:5. At 4:5 the photograph was 469px of a
           375px-wide phone and pushed the whole type block past the fold —
           not just the buttons but the price. Square costs about 14% off the
           top of the frame, which is sky and the outer edge of the fireworks,
           and keeps the machine, the whip, the flag and the number panel.
           The vh cap stops it turning into a 768px slab on a tablet. */
        /* `w-full` is load-bearing next to the aspect ratio. An aspect-ratio
           box clamped by max-height gives up WIDTH to keep the ratio, so on a
           768px tablet the photograph collapsed to a 512px square with a
           column of black beside it. Fixing the width means max-height only
           clamps the height, and object-cover takes the difference out of the
           crop, which is what it is there for. */
        class="border-shop-line relative order-1 aspect-square w-full max-h-[50vh] lg:order-2 lg:aspect-auto lg:max-h-none lg:border-l"
      >
        {
          heroSource ? (
            <img
              srcset={heroSrcset}
              sizes={HERO_SIZES}
              alt={heroAlt}
              width={heroSource.width}
              height={heroSource.height}
              loading="eager"
              fetchpriority="high"
              decoding="sync"
              class="absolute inset-0 h-full w-full object-cover"
              /* 58%, not centre. The machine and the number panel are in the
                 lower half of the frame and the fireworks are in the upper;
                 when the panel is wider than 3:4 and has to trim, this takes
                 it off the sky rather than off the machine. */
              style="object-position:50% 58%"
            />
          ) : (
            <Shot shot="hero-build" fill eager sizes={HERO_SIZES} />
          )
        }
      </div>

      <!-- Type field. No scrim, no plate, no overlay: flat #111. -->
      <div
        /* py-10 below sm is measured, not chosen. It is what puts the whole
           proposition — photograph, price, headline, subhead and the primary
           button — above the fold on a 375x812 phone once the 68px sticky
           header and the 57px call bar are taken off. py-12 left the button
           16px short of it. */
        class="order-2 flex items-center px-5 py-10 sm:px-8 sm:py-14 lg:order-1 lg:px-0 lg:py-20 lg:pr-14"
      >
        <div class="w-full max-w-[34rem]">
          <!-- The one number that stops people calling, set as a chip above
               the headline rather than as a sentence inside the block.

               Sentence case on purpose. An all-caps eyebrow over a heading is
               the pattern this site avoids everywhere else and this sits in
               exactly that slot; what keeps it clear is that it carries a
               fact rather than a category label, and appears once on the site
               rather than above every heading. -->
          <p
            class="border-shop-line bend mb-4 inline-flex items-baseline gap-2 border px-3 py-1.5"
          >
            <span class="text-steel text-[0.8125rem]">Full cages from</span>
            <span class="font-display text-[0.9375rem] font-bold"
              >{pricing.cageStartingAtDisplay}</span
            >
          </p>

          <!-- The city belongs in the h1, not only in the <title>: "roll
               cages Tucson" is the search this page has to win, and the h1 is
               the strongest on-page signal for it.

               It can breathe a little now. On the old plate the headline was
               held down by the width of the plate; against an open black
               field it takes 44px again, with the letterfit still at -0.03em
               and the leading still at 1.02. Tight fit and tight leading is
               what reads athletic — loose is what reads like a template. -->
          <h1
            class="max-w-[16ch] text-[clamp(2rem,3.4vw,2.75rem)] leading-[1.02] font-bold tracking-[-0.03em]"
          >
            Custom UTV roll cages in Tucson.
          </h1>

          <p class="text-steel mt-4 max-w-[42ch] text-base leading-[1.55]">
            Built by {business.owner}. {
              business.yearsInBusiness.replace(/^over/, 'Over')
            } of it, and he welds every one himself.
          </p>

          <!-- The quote form leads and the phone follows it.

               That is a conversion trade and not only a visual one, because
               the phone is how a one-man shop books work. What makes it fair
               is that the number has not moved — it is in the sticky header
               on every page and in the fixed call/text bar at the bottom of
               every phone screen — while the form is the only thing that
               catches somebody deciding at ten at night.

               steel/75 on the ghost border, not steel/50: on a ghost button
               the border IS the control's boundary, so it answers to the 3:1
               non-text contrast floor. Against flat #111, 50% measures
               2.42:1 and 75% measures 3.94:1. -->
          <div class="mt-7 flex flex-col gap-3 sm:mt-8 sm:flex-row sm:items-center">
            <a
              href="/contact/"
              class="font-display bg-bone text-shop bend hover:bg-bone-lift hover:border-bone-lift border border-bone px-6 py-3.5 text-center font-bold transition-colors"
            >
              Get a quote
            </a>
            <a
              href={phone.tel}
              data-analytics="call-hero"
              class="font-display border-steel/75 text-bone bend hover:border-bone hover:bg-bone/5 border px-6 py-3.5 text-center font-bold transition-colors"
            >
              Call {phone.display}
            </a>
          </div>

          <!-- Hours next to the call, not only in the footer. Someone
               deciding to ring a one-man shop needs to know whether anybody
               will pick up. 13px to match the chip, so the two tertiary items
               in this block agree instead of sitting a pixel apart. -->
          <p class="text-steel mt-6 text-[0.8125rem] tracking-[0.01em]">
            {business.hours.display}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ==========================================================
       WHAT HE BUILDS
       One photo and a plain list. The detail lives on /services/.
       ========================================================== -->
  <section class="bg-bone">
    <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-24">
      <BendRule class="mb-8 max-w-xs" />

      <h2 class="max-w-[16ch] text-[clamp(2rem,5vw,3.25rem)]">
        What comes out of the shop
      </h2>

      <!-- One photo and a list, not four photo cards. Each service keeps its
           own heading and anchor on /services/; repeating all four here as
           cards was the single busiest thing on the page. -->
      <div class="mt-12 grid gap-10 lg:grid-cols-2 lg:gap-16">
        <Shot shot="bend-bare" light class="w-full" />

        <div>
          <ul class="border-bone-line border-t">
            {services.map((s) => (
              <li class="border-bone-line border-b">
                <a
                  href={`/services/#${s.slug}`}
                  class="hover:text-slate flex flex-col gap-1.5 py-5 transition-colors"
                >
                  <span class="flex items-baseline justify-between gap-4">
                    <span class="font-display text-xl font-bold">{s.title}</span>
                    {s.startingAt && (
                      <span class="font-display shrink-0 text-lg font-bold">
                        From {s.startingAt}
                      </span>
                    )}
                  </span>
                  <span class="text-slate max-w-[44ch]">{s.blurb}</span>
                </a>
              </li>
            ))}
          </ul>

          <a
            href="/services/"
            class="text-shop mt-6 inline-block font-semibold underline decoration-1 underline-offset-4"
          >
            What goes into each of these
          </a>
        </div>
      </div>
      <p class="text-slate mt-10 max-w-[62ch] text-lg">
        All welding is MIG and done in house. Powder coating is sent out to a
        coater.
      </p>
    </div>
  </section>

  <!-- ==========================================================
       PRICE
       Not knowing what a cage costs is what stops people calling,
       so the number gets a section to itself.
       ========================================================== -->
  <section class="bg-shop text-bone">
    <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-24">
      <div class="grid gap-10 lg:grid-cols-[auto_1fr] lg:gap-16">
        <div>
          <p class="text-steel text-lg">A typical full cage runs</p>
          <p
            class="font-display text-bone mt-1 text-[clamp(4rem,14vw,8rem)] leading-[0.85] font-extrabold tracking-[-0.04em]"
          >
            {pricing.cageStartingAtDisplay}
          </p>
        </div>

        <div class="max-w-[52ch] space-y-5 text-lg">
          <p>
            The price depends on the machine, the seat count, and what else gets
            built while it is apart: doors, a roof, mounts.
          </p>
          <p class="text-steel">
            Call with the year, make and model and you will get a number on the
            phone. You do not need an appointment to ask what something costs.
          </p>
          <p class="text-steel">
            Doors, roofs and custom work are {terms.servicePricing.toLowerCase()}.
            Either way you are not without the machine long — {terms.leadTime.toLowerCase()}.
          </p>
          <p>
            Mike quotes the job and Mike welds it — <a
              href="/about/"
              class="font-semibold underline decoration-1 underline-offset-4"
              >more about the shop</a
            >.
          </p>
          <div class="flex flex-col gap-3 pt-2 sm:flex-row">
            <a
              href={phone.tel}
              data-analytics="call-price"
              class="font-display bg-bone text-shop bend border border-bone hover:bg-transparent hover:text-bone px-6 py-3.5 text-center font-bold transition-colors"
            >
              Call {phone.display}
            </a>
            <a
              href="/contact/"
              class="font-display border-steel/50 bend hover:border-bone border px-6 py-3.5 text-center font-bold transition-colors"
            >
              Send the details
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==========================================================
       GALLERY TEASER — dense, square, no gaps. The camera-roll grid.
       ========================================================== -->
  <section class="bg-bone">
    <div class="mx-auto max-w-6xl px-5 pt-16 sm:px-8 sm:pt-24">
      <BendRule class="mb-8 max-w-xs" />
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <h2 class="text-[clamp(2rem,5vw,3.25rem)]">Machines that have been through</h2>
        <a
          href="/gallery/"
          class="text-shop font-semibold underline decoration-1 underline-offset-4"
        >
          See the full gallery
        </a>
      </div>
      <p class="text-slate mt-4 max-w-[52ch] text-lg">
        {platforms.map((p) => p.name).join(', ')} — and plenty that do not fit a
        category.
      </p>
    </div>

    <!-- Full-bleed, gutterless, square. This is the one dense thing on the
         page and it is meant to read as a wall of work. -->
    <div class="mt-10 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6">
      {teaser.map((photo) => <GalleryTile photo={photo} href="/gallery/" />)}
    </div>
  </section>

  <!-- ==========================================================
       CLOSING CTA
       ========================================================== -->
  <section class="bg-shop text-bone">
    <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-20">
      <h2 class="max-w-[20ch] text-[clamp(2rem,5vw,3.25rem)]">
        Tell me the machine and what you want done.
      </h2>
      <p class="text-steel mt-5 max-w-[48ch] text-lg">
        Year, make and model is enough to start. Photos help if you have them.
      </p>
      <!-- The towns, written out once on the home page in a sentence rather
           than as a keyword list. Somebody in Marana searching for a cage
           needs to see their own town somewhere on the page before they
           believe the shop is close enough to bother with. -->
      <p class="text-steel mt-3 max-w-[48ch] text-lg">
        Machines come in from {business.serviceAreaLine} and the rest of
        southern Arizona.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a
          href={phone.tel}
          data-analytics="call-closing"
          class="font-display bg-bone text-shop bend border border-bone hover:bg-transparent hover:text-bone px-7 py-4 text-center text-lg font-bold transition-colors"
        >
          Call {phone.display}
        </a>
        <a
          href={phone.sms}
          data-analytics="text-closing"
          class="font-display border-steel/50 bend hover:border-bone border px-7 py-4 text-center text-lg font-bold transition-colors"
        >
          Send a text
        </a>
      </div>
    </div>
  </section>
</Base>
