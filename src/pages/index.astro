---
import Base from '../layouts/Base.astro';
import Shot from '../components/Shot.astro';
import GalleryTile from '../components/GalleryTile.astro';
import NeedsInput from '../components/NeedsInput.astro';
import BendRule from '../components/BendRule.astro';
import {
  business,
  phone,
  pricing,
  services,
  platforms,
  terms,
} from '../config/site';
import { gallery } from '../config/gallery';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { shots } from '../config/shots';

/* Home is the only page carrying the LocalBusiness block, so the markup
   describes one business rather than eight. */

/* ---------------------------------------------------------
   The hero is generated here rather than through <Shot>, because it is the
   LCP element and has to be preloaded. Building the variants once and using
   the same list for BOTH the preload link and the <img> guarantees they
   match — a preload that misses by one URL downloads the image twice and is
   worse than no preload at all.
   --------------------------------------------------------- */
const heroShot = shots['hero-build'];
const photoFiles = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/photos/*.{jpg,jpeg,png,webp,avif}',
  { eager: true }
);
const heroSource = heroShot.file
  ? photoFiles[`../assets/photos/${heroShot.file}`]?.default
  : undefined;

/* Widths stop at the source's own width. Asking for 1920 or 2560 from a
   1536-wide file makes Astro upscale and re-encode, which is softer than
   letting the browser scale the native file. That upscaling was the actual
   cause of the soft hero, not the compression, so quality sits at 80: 86 cost
   ~0.4s of LCP for a difference that is not visible at these sizes. */
/* Capped at 2560 rather than at the source's full 3840. A 3840-wide webp is
   most of a megabyte and it would be the LCP request on every retina desktop;
   2560 is about a third of that. The cost is that a 2x laptop at 1512 CSS
   asks for 3024 and gets 2560, an upscale of 1.18 — far below the 1.9 that
   made the old hero visibly soft, and not something you can see at arm's
   length. Every 1x monitor, which is most of them, is served exactly. */
const buildSrcset = async (src: ImageMetadata | undefined, maxWidth = 2560) => {
  if (!src) return '';
  const cap = Math.min(src.width, maxWidth);
  const widths = [640, 960, 1280, 1600, 2048, 2560].filter((w) => w <= cap);
  if (!widths.includes(cap)) widths.push(cap);
  const made = await Promise.all(
    widths.map((width) => getImage({ src, width, format: 'webp', quality: 80 }))
  );
  return made.map((v, i) => `${v.src} ${widths[i]}w`).join(', ');
};

/* ONE photograph, one slot, no art direction.

   The hero used to carry two different machines — a portrait night shot on
   phones and a landscape daylight shot on wide screens — because neither
   could do the job alone. The portrait one upscaled about 1.9x in a wide box
   and that was the blur; the landscape one had its machine running off the
   left edge of the original frame, so no crop showed the whole of it.

   The photograph supplied on 2026-09-22 removes the reason for the split. It
   is landscape, it is 3840px, and the machine sits with margin on all four
   sides, so one source now fills a full-bleed hero at every breakpoint and a
   wide crop trims sky and sand instead of bodywork.

   One source also gives the alt text back: with two machines it had to
   describe what was true of both, and it can now describe this photograph. */
/* The phone gets a different photograph, and this time it is a choice rather
   than a workaround.

   A hero box is wide on a desktop and tall on a phone, and no single frame is
   both. The red Pro R is 16:10 and suits the wide box; forced into a portrait
   phone hero it showed 58% of its width against the 75% the machine occupies,
   losing the front bumper and the spare. The night dune shot is 3:4 and fills
   a phone screen with nothing cropped at all — and at 375px it is asking for
   750 device pixels of a 1536px file, so the upscaling that made it soft in a
   WIDE box never happens in a tall one.

   The cost is the alt text. A <picture> has one alt for every <source>, and
   these are two different machines, so it has to describe what is true of
   both rather than naming a colour half the visitors cannot see. */
const heroNarrowSource =
  photoFiles['../assets/photos/hero-night-dune-66.jpg']?.default;

const heroSrcset = await buildSrcset(heroSource);
const heroNarrowSrcset = await buildSrcset(heroNarrowSource);
const heroAlt = 'A four-seat UTV fitted with a custom M1 Off-Road roll cage.';

/* Matches the <source media> below, so the preload picks the same file the
   browser will actually use. 640px is the sm breakpoint. */
const HERO_WIDE_MEDIA = '(min-width: 640px)';
const HERO_NARROW_MEDIA = '(max-width: 639.98px)';

/* Full bleed, so the slot is the viewport. This MUST match the sizes on the
   <img> below — a preload that disagrees by one attribute picks a different
   candidate and downloads the hero twice. */
const HERO_SIZES = '100vw';

/* Six tiles for the teaser strip, taken one at a time across the platforms so
   the row is not six near-identical RZRs. */
const teaser = [
  gallery['polaris-rzr'][0],
  gallery['can-am'][0],
  gallery['kawasaki'][0],
  gallery['polaris-rzr'][10],
  gallery['in-the-shop'][0],
  gallery['polaris-rzr'][4],
];
---

<Base
  title="M1 Off-Road | Custom UTV Roll Cages & Fabrication Tucson, AZ"
  description="Custom roll cages, doors, roofs and bumpers for Polaris RZR, Can-Am and other SxS machines. MIG welded in Tucson, AZ. Full cages from $2,500."
  schema
  preloadImage={[
    { srcset: heroSrcset, sizes: HERO_SIZES, media: HERO_WIDE_MEDIA },
    { srcset: heroNarrowSrcset, sizes: HERO_SIZES, media: HERO_NARROW_MEDIA },
  ]}
>
  <!-- ==========================================================
       HERO — the photograph fills it, the words sit on it.

       Back to the original arrangement, which the new photograph can finally
       carry. The previous two rewrites existed to work around the pictures
       available at the time: one was portrait and 1536px, so a wide box both
       cropped the machine and upscaled it, and the other had the machine
       running off the left edge of the frame. Neither could be a full-bleed
       hero without losing the thing it was a photograph of.

       This one is 3840x2880, landscape, and the machine sits with margin on
       all four sides — so a wide crop takes sky and sand instead of bodywork,
       and there is enough resolution left over to cap the ladder well below
       the source and still serve every 1x monitor exactly.
       ========================================================== -->
  <section class="bg-shop text-bone relative overflow-hidden">
    <!-- The photograph gets its own absolutely positioned wrapper rather than
         being stretched against the section directly. An <img> at height:100%
         needs a containing block with a DEFINITE height, and a box that takes
         its height from min-height plus content resolves to auto in Firefox —
         the image then falls back to its intrinsic height and leaves the
         bottom of the hero uncovered. inset-0 is definite in every engine. -->
    <div class="absolute inset-0">
      {
        heroSource ? (
          <picture>
            {heroNarrowSrcset && (
              <source
                media={HERO_NARROW_MEDIA}
                srcset={heroNarrowSrcset}
                sizes={HERO_SIZES}
                width="1536"
                height="2048"
              />
            )}
            <img
              srcset={heroSrcset}
              sizes={HERO_SIZES}
              alt={heroAlt}
              width={heroSource.width}
              height={heroSource.height}
              loading="eager"
              fetchpriority="high"
              decoding="sync"
              class="h-full w-full object-cover object-[50%_58%] sm:object-[50%_55%]"
            />
          </picture>
        ) : (
          <Shot shot="hero-build" fill eager sizes="100vw" />
        )
      }

      <!-- Two hero-wide scrims, one per crop, because one curve cannot serve
           both. The phone hero is a taller box holding the same amount of
           text, so the words start higher up the gradient than they do on the
           wide crop; the night frame also has a lit whip and fireworks in the
           upper half, which are the brightest things in either photograph.
           The phone therefore gets its own steeper curve instead of the two
           sharing a compromise that is too heavy for one and too light for
           the other.

           Both are lighter than they would have to be alone, because the
           block that holds the text carries a third gradient of its own. -->
      <div
        class="absolute inset-0 sm:hidden"
        style="background:linear-gradient(to top, rgb(17 17 17 / .86) 0%, rgb(17 17 17 / .70) 28%, rgb(17 17 17 / .42) 52%, rgb(17 17 17 / .14) 74%, rgb(17 17 17 / 0) 92%)"
        aria-hidden="true"
      >
      </div>
      <div
        class="absolute inset-0 hidden sm:block"
        style="background:linear-gradient(to top, rgb(17 17 17 / .72) 0%, rgb(17 17 17 / .50) 24%, rgb(17 17 17 / .24) 46%, rgb(17 17 17 / .06) 68%, rgb(17 17 17 / 0) 88%)"
        aria-hidden="true"
      >
      </div>
    </div>

    <!-- A FULL-WIDTH sizer takes the hero's height from the VIEWPORT width, so
         the box keeps roughly the photograph's own proportions instead of
         holding one height while the width runs away.

         The caps are chosen against this photograph. The machine spans about
         59% of the frame's height, so the hero has to show at least that much
         of it: at 1440 it shows 69%, at 1920 62%. min-height rather than
         aspect-ratio, because aspect-ratio is a fixed height and the text
         would overflow it on a phone. -->
    <div
      class="relative flex min-h-[max(32rem,min(133vw,80vh))] items-end sm:min-h-[max(28rem,min(56vw,88vh,46rem))] lg:min-h-[max(30rem,min(52vw,90vh,60rem))]"
    >
      <!-- A second scrim, and the only one anchored to the TEXT rather than to
           the hero box. This is the piece that makes contrast hold across the
           range, and the hero-sized gradient above has been lightened because
           of it.

           A hero-sized gradient cannot track the words. The hero's height
           comes from the viewport and the text stack's does not, so as the
           window narrows the words occupy more of the frame and ride up into
           the thin end of the curve: at 1024 the headline measured 2.79:1 and
           the subhead 3.57:1 against floors of 3 and 4.5, while the same
           markup at 1440 was comfortably clear. Painting the gradient on the
           block that holds the text makes its height the text's height at
           every viewport, so the two cannot drift apart.

           Splitting the work this way also costs the photograph less than one
           heavy hero-wide curve did: the darkening is spent on the band the
           words occupy rather than on the band the machine occupies. -->
      <div
        class="w-full bg-[linear-gradient(to_top,rgb(17_17_17/0.64)_0%,rgb(17_17_17/0.56)_80%,rgb(17_17_17/0)_100%)]"
      >
      <div class="mx-auto w-full max-w-6xl px-5 py-10 sm:px-8 sm:py-14 lg:py-16">
        <!-- The one number that stops people calling, set as a chip above the
             headline. Sentence case on purpose: an all-caps eyebrow over a
             heading is the pattern this site avoids, and what keeps this clear
             of it is that it carries a fact rather than a category label, and
             appears once rather than above every heading.

             The chip has its own translucent fill here, unlike on the flat
             black field it came from — a hairline border alone disappears
             against a photograph. -->
        <p
          class="border-shop-line bg-shop/90 bend mb-4 inline-flex items-baseline gap-2 border px-3 py-1.5 backdrop-blur-[2px]"
        >
          <span class="text-steel text-[0.8125rem]">Full cages from</span>
          <span class="font-display text-[0.9375rem] font-bold"
            >{pricing.cageStartingAtDisplay}</span
          >
        </p>

        <!-- The city belongs in the h1, not only in the <title>: "roll cages
             Tucson" is the search this page has to win, and the h1 is the
             strongest on-page signal for it.

             44px with the letterfit at -0.03em and the leading at 1.02. Tight
             fit and tight leading is what reads athletic; a big sans set
             loosely is what reads like a template, and that — not the size —
             was what made the first version of this headline feel generic. -->
        <h1
          class="max-w-[16ch] text-[clamp(2rem,3.4vw,2.75rem)] leading-[1.02] font-bold tracking-[-0.03em]"
        >
          Custom UTV roll cages in Tucson.
        </h1>

        <!-- bone at 80%, not steel. steel's documented 5.8:1 holds against
             flat #111; this line sits on a photograph, where that figure does
             not apply, so it takes its contrast from the scrim and is
             measured rather than assumed. -->
        <p class="text-bone/90 mt-4 max-w-[42ch] text-base leading-[1.55]">
          Built by {business.owner}. {
            business.yearsInBusiness.replace(/^over/, 'Over')
          } of it, and he welds every one himself.
        </p>

        <!-- The quote form leads and the phone follows it. That is a
             conversion trade as much as a visual one, because the phone is how
             a one-man shop books work; what makes it fair is that the number
             has not moved — it is in the sticky header on every page and in
             the fixed call/text bar at the bottom of every phone screen —
             while the form is the only thing that catches somebody deciding at
             ten at night.

             The ghost button's border is bone/60 rather than steel here. On a
             photograph a grey hairline vanishes, and on a ghost button the
             border IS the control's boundary, so it answers to the 3:1
             non-text contrast floor rather than to taste. -->
        <div class="mt-7 flex flex-col gap-3 sm:mt-8 sm:flex-row sm:items-center">
          <a
            href="/contact/"
            class="font-display bg-bone text-shop bend hover:bg-bone-lift hover:border-bone-lift border border-bone px-6 py-3.5 text-center font-bold transition-colors"
          >
            Get a quote
          </a>
          <a
            href={phone.tel}
            data-analytics="call-hero"
            class="font-display border-bone/60 text-bone bend hover:border-bone hover:bg-bone/10 border px-6 py-3.5 text-center font-bold transition-colors"
          >
            Call {phone.display}
          </a>
        </div>

        <!-- Hours next to the call, not only in the footer. Someone deciding
             to ring a one-man shop needs to know whether anybody will pick
             up. -->
        <p class="text-bone/75 mt-6 text-[0.8125rem] tracking-[0.01em]">
          {business.hours.display}
        </p>
      </div>
      </div>
    </div>
  </section>

  <!-- ==========================================================
       WHAT HE BUILDS
       One photo and a plain list. The detail lives on /services/.
       ========================================================== -->
  <section class="bg-bone">
    <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-24">
      <BendRule class="mb-8 max-w-xs" />

      <h2 class="max-w-[16ch] text-[clamp(2rem,5vw,3.25rem)]">
        What comes out of the shop
      </h2>

      <!-- One photo and a list, not four photo cards. Each service keeps its
           own heading and anchor on /services/; repeating all four here as
           cards was the single busiest thing on the page. -->
      <div class="mt-12 grid gap-10 lg:grid-cols-2 lg:gap-16">
        <Shot shot="bend-bare" light class="w-full" />

        <div>
          <ul class="border-bone-line border-t">
            {services.map((s) => (
              <li class="border-bone-line border-b">
                <a
                  href={`/services/#${s.slug}`}
                  class="hover:text-slate flex flex-col gap-1.5 py-5 transition-colors"
                >
                  <span class="flex items-baseline justify-between gap-4">
                    <span class="font-display text-xl font-bold">{s.title}</span>
                    {s.startingAt && (
                      <span class="font-display shrink-0 text-lg font-bold">
                        From {s.startingAt}
                      </span>
                    )}
                  </span>
                  <span class="text-slate max-w-[44ch]">{s.blurb}</span>
                </a>
              </li>
            ))}
          </ul>

          <a
            href="/services/"
            class="text-shop mt-6 inline-block font-semibold underline decoration-1 underline-offset-4"
          >
            What goes into each of these
          </a>
        </div>
      </div>
      <p class="text-slate mt-10 max-w-[62ch] text-lg">
        All welding is MIG and done in house. Powder coating is sent out to a
        coater.
      </p>
    </div>
  </section>

  <!-- ==========================================================
       PRICE
       Not knowing what a cage costs is what stops people calling,
       so the number gets a section to itself.
       ========================================================== -->
  <section class="bg-shop text-bone">
    <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-24">
      <div class="grid gap-10 lg:grid-cols-[auto_1fr] lg:gap-16">
        <div>
          <p class="text-steel text-lg">A typical full cage runs</p>
          <p
            class="font-display text-bone mt-1 text-[clamp(4rem,14vw,8rem)] leading-[0.85] font-extrabold tracking-[-0.04em]"
          >
            {pricing.cageStartingAtDisplay}
          </p>
        </div>

        <div class="max-w-[52ch] space-y-5 text-lg">
          <p>
            The price depends on the machine, the seat count, and what else gets
            built while it is apart: doors, a roof, mounts.
          </p>
          <p class="text-steel">
            Call with the year, make and model and you will get a number on the
            phone. You do not need an appointment to ask what something costs.
          </p>
          <p class="text-steel">
            Doors, roofs and custom work are {terms.servicePricing.toLowerCase()}.
            Either way you are not without the machine long — {terms.leadTime.toLowerCase()}.
          </p>
          <p>
            Mike quotes the job and Mike welds it — <a
              href="/about/"
              class="font-semibold underline decoration-1 underline-offset-4"
              >more about the shop</a
            >.
          </p>
          <div class="flex flex-col gap-3 pt-2 sm:flex-row">
            <a
              href={phone.tel}
              data-analytics="call-price"
              class="font-display bg-bone text-shop bend border border-bone hover:bg-transparent hover:text-bone px-6 py-3.5 text-center font-bold transition-colors"
            >
              Call {phone.display}
            </a>
            <a
              href="/contact/"
              class="font-display border-steel/50 bend hover:border-bone border px-6 py-3.5 text-center font-bold transition-colors"
            >
              Send the details
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==========================================================
       GALLERY TEASER — dense, square, no gaps. The camera-roll grid.
       ========================================================== -->
  <section class="bg-bone">
    <div class="mx-auto max-w-6xl px-5 pt-16 sm:px-8 sm:pt-24">
      <BendRule class="mb-8 max-w-xs" />
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <h2 class="text-[clamp(2rem,5vw,3.25rem)]">Machines that have been through</h2>
        <a
          href="/gallery/"
          class="text-shop font-semibold underline decoration-1 underline-offset-4"
        >
          See the full gallery
        </a>
      </div>
      <p class="text-slate mt-4 max-w-[52ch] text-lg">
        {platforms.map((p) => p.name).join(', ')} — and plenty that do not fit a
        category.
      </p>
    </div>

    <!-- Full-bleed, gutterless, square. This is the one dense thing on the
         page and it is meant to read as a wall of work. -->
    <div class="mt-10 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6">
      {teaser.map((photo) => <GalleryTile photo={photo} href="/gallery/" />)}
    </div>
  </section>

  <!-- ==========================================================
       CLOSING CTA
       ========================================================== -->
  <section class="bg-shop text-bone">
    <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-20">
      <h2 class="max-w-[20ch] text-[clamp(2rem,5vw,3.25rem)]">
        Tell me the machine and what you want done.
      </h2>
      <p class="text-steel mt-5 max-w-[48ch] text-lg">
        Year, make and model is enough to start. Photos help if you have them.
      </p>
      <!-- The towns, written out once on the home page in a sentence rather
           than as a keyword list. Somebody in Marana searching for a cage
           needs to see their own town somewhere on the page before they
           believe the shop is close enough to bother with. -->
      <p class="text-steel mt-3 max-w-[48ch] text-lg">
        Machines come in from {business.serviceAreaLine} and the rest of
        southern Arizona.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a
          href={phone.tel}
          data-analytics="call-closing"
          class="font-display bg-bone text-shop bend border border-bone hover:bg-transparent hover:text-bone px-7 py-4 text-center text-lg font-bold transition-colors"
        >
          Call {phone.display}
        </a>
        <a
          href={phone.sms}
          data-analytics="text-closing"
          class="font-display border-steel/50 bend hover:border-bone border px-7 py-4 text-center text-lg font-bold transition-colors"
        >
          Send a text
        </a>
      </div>
    </div>
  </section>
</Base>
