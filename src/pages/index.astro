---
import Base from '../layouts/Base.astro';
import Shot from '../components/Shot.astro';
import GalleryTile from '../components/GalleryTile.astro';
import NeedsInput from '../components/NeedsInput.astro';
import BendRule from '../components/BendRule.astro';
import {
  business,
  phone,
  pricing,
  services,
  platforms,
  terms,
} from '../config/site';
import { gallery } from '../config/gallery';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { shots } from '../config/shots';

/* Home is the only page carrying the LocalBusiness block, so the markup
   describes one business rather than eight. */

/* ---------------------------------------------------------
   The hero is generated here rather than through <Shot>, because it is the
   LCP element and has to be preloaded. Building the variants once and using
   the same list for BOTH the preload link and the <img> guarantees they
   match — a preload that misses by one URL downloads the image twice and is
   worse than no preload at all.
   --------------------------------------------------------- */
const heroShot = shots['hero-build'];
const photoFiles = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/photos/*.{jpg,jpeg,png,webp,avif}',
  { eager: true }
);
const heroSource = heroShot.file
  ? photoFiles[`../assets/photos/${heroShot.file}`]?.default
  : undefined;

/* Two sources, art-directed — and deliberately two different photographs.

   A hero box is wide; the night dune shot is portrait and its machine runs off
   the left edge of the original frame, so on a desktop screen it could never
   show a whole machine no matter how it was cropped. It is also only 1536px
   across, which meant upscaling on any retina display. On a phone it is
   perfect: portrait fills the screen with nothing cropped, and it carries the
   shop's own number panel.

   So the phone keeps it, and wide screens get a machine photographed side-on
   in daylight at 2048px with every corner of it in frame. */
/* Widths stop at the source's own width. Asking for 1920 or 2560 from a
   1536-wide file makes Astro upscale and re-encode, which is softer than
   letting the browser scale the native file. That upscaling was the actual
   cause of the soft hero, not the compression, so quality sits at 80: 86 cost
   ~0.4s of LCP for a difference that is not visible at these sizes. */
const buildSrcset = async (src: ImageMetadata | undefined) => {
  if (!src) return '';
  const widths = [640, 960, 1280, 1600, 2048].filter((w) => w <= src.width);
  if (!widths.includes(src.width)) widths.push(src.width);
  const made = await Promise.all(
    widths.map((width) => getImage({ src, width, format: 'webp', quality: 80 }))
  );
  return made.map((v, i) => `${v.src} ${widths[i]}w`).join(', ');
};

/* Desktop hero: the red Pro R, 2048px wide, whole machine in frame with real
   margin on all four sides — which is the part that matters. A photograph
   whose subject touches the edges has no background left to give, so a wide
   box crops the machine itself; this one can be trimmed at any window shape
   and still lose only desert. The bare steel cage is the point: it is the
   actual tube work, unpainted, which is what the shop sells.

   The night dune shot stays on phones. Portrait fills a phone screen with
   nothing cropped and it carries the shop's own number panel, but it cannot do
   the same job wide: its machine runs off the left edge of the original frame,
   so no crop shows the whole of it, and at 1536px across it was upscaled
   roughly 1.9x on a retina display. That was the blur. */
const heroWideSource = photoFiles['../assets/photos/hero-rzr-red-wide.jpg']?.default;

const heroSrcset = await buildSrcset(heroSource);
const heroWideSrcset = await buildSrcset(heroWideSource);
/* A <picture> has one alt for every <source>, and these two sources are
   different machines. So the alt describes what is true of both rather than
   naming a colour a desktop visitor cannot see or a phone visitor can. */
const heroAlt =
  'A four-seat UTV fitted with a custom M1 Off-Road roll cage.';

/* Matches the <source media> below, so the preload picks the same file the
   browser will actually use. */
const HERO_WIDE_MEDIA = '(min-width: 640px)';

/* Six tiles for the teaser strip, taken one at a time across the platforms so
   the row is not six near-identical RZRs. */
const teaser = [
  gallery['polaris-rzr'][0],
  gallery['can-am'][0],
  gallery['kawasaki'][0],
  gallery['polaris-rzr'][10],
  gallery['in-the-shop'][0],
  gallery['polaris-rzr'][4],
];
---

<Base
  title="M1 Off-Road | Custom UTV Roll Cages & Fabrication Tucson, AZ"
  description="Custom roll cages, doors, roofs and bumpers for Polaris RZR, Can-Am and other SxS machines. MIG welded in Tucson, AZ. Full cages from $2,500."
  schema
  preloadImage={heroWideSrcset ? { srcset: heroWideSrcset, sizes: '100vw', media: HERO_WIDE_MEDIA } : undefined}
>
  <!-- ==========================================================
       HERO — the one place on this site that raises its voice.
       Everything below it is deliberately quiet.
       ========================================================== -->
  <section class="bg-shop text-bone relative overflow-hidden">
    <!-- A FULL-WIDTH sizer sets the hero height from the VIEWPORT width, so the
         box stays close to the photograph's own ratio instead of holding one
         height while the width runs away. Putting this on the max-w-6xl content
         block instead froze the height at 1152/1.6 = 720px and let the crop
         creep back in on wide monitors.

         min-height rather than aspect-ratio, because aspect-ratio is a fixed
         height: when the headline, price and buttons are taller than it on a
         phone, the text overflows the hero onto the section below. 133vw is
         3:4 and 62.5vw is 16:10 — the same proportions, but the box can grow
         when the content needs it to. -->
    <div
      class="relative flex min-h-[max(32rem,min(133vw,80vh))] flex-col sm:min-h-[max(28rem,min(66.6vw,88vh,52rem))] lg:min-h-[max(28rem,min(66.6vw,92vh,62rem))]"
    >
      <!-- The photograph's own band, and the reason the hero is a column
           rather than a bottom-aligned row. Two things are solved here.

           PROPORTION. The plate's height comes from its words; the hero's
           comes from the viewport. Those are independent, which is fine on a
           wide screen — 828px of hero against 459px of plate — and not fine
           on a phone, where the hero bottoms out at its 32rem minimum while
           the plate still wants 451px of it. That left 61px of picture: a
           black box with a stripe of photograph on top. This band claims its
           height first and the plate takes what it needs underneath, so the
           split holds at any size instead of only where the min-height was
           tuned. `grow` lets it absorb the slack on wide screens, where the
           min-height is the larger number and there is room to give away.

           CROP, which is why the photograph lives INSIDE the band rather than
           behind the whole hero. object-fit resolves against its own box.
           Stretched over the full phone hero, the portrait night shot is
           taller than it is wide, so height binds, no vertical crop happens,
           and object-position does nothing whatsoever — the visible band came
           out as the top third of the frame, which is sky and fireworks. The
           machine is in the lower half, behind the plate. Bounded to this
           band the box is landscape, width binds instead, and 62% then picks
           the part of the photograph the machine is actually in.

           `sm:static` hands the photograph back to the sizer from sm up, so a
           wide screen returns to full bleed behind the plate. -->
      <!-- The sm floor is viewport-relative because a fixed one does not hold
           across the range. The plate's height barely moves between 768px and
           1440px, while the hero's shrinks with the window — so a flat 10rem
           band was 45% of the hero at 1440 and 27% at 768, where the plate
           had swallowed most of the machine. 34vw scales it with the window,
           22rem stops it growing past what a wide screen needs, and 38vh
           keeps it off a short laptop screen where a tall hero would push the
           phone number below the fold. -->
      <div
        class="relative min-h-[16rem] grow sm:static sm:min-h-[min(22rem,34vw,38vh)]"
      >
        <!-- An <img> sized with height:100% needs a containing block with a
             DEFINITE height. A container taking its height from min-height
             plus content resolves to auto in Firefox, and the image then
             falls back to its intrinsic height and leaves part of the hero
             uncovered. inset-0 is definite in every engine. -->
        <div class="absolute inset-0">
          {
            heroSource ? (
              <picture>
                {heroWideSrcset && (
                  <source
                    media={HERO_WIDE_MEDIA}
                    srcset={heroWideSrcset}
                    sizes="100vw"
                    width="2048"
                    height="1280"
                  />
                )}
                <img
                  srcset={heroSrcset}
                  sizes="100vw"
                  alt={heroAlt}
                  width={heroSource.width}
                  height={heroSource.height}
                  loading="eager"
                  fetchpriority="high"
                  decoding="sync"
                  class="h-full w-full object-cover"
                  style="object-position:50% 62%"
                />
              </picture>
            ) : (
              <Shot shot="hero-build" fill eager sizes="100vw" />
            )
          }

          <!-- ONE scrim now, and a light one, where there used to be three.

               All three existed to hold text directly on the photograph, and
               that is what forced them to be heavy: the words needed a dark
               enough background wherever they happened to fall, so the whole
               picture got dimmed to protect the brightest patch behind a
               letter. The words are on their own plate now, so the photograph
               carries nothing. This is all that is left to do — settle the
               bottom edge so the plate has something to sit against rather
               than looking pasted on.

               It clears entirely by the halfway mark, so the machine sits in
               an undimmed picture for the first time. Both crops share it:
               with no text riding on the photo, there is nothing left for two
               separate curves to disagree about. -->
          <div
            class="absolute inset-0"
            style="background:linear-gradient(to top, rgb(17 17 17 / .62) 0%, rgb(17 17 17 / .28) 24%, rgb(17 17 17 / .04) 52%, rgb(17 17 17 / 0) 100%)"
            aria-hidden="true"
          >
          </div>
        </div>
      </div>

      <!-- The words sit on a plate, not on the photograph.

           This is the change that lets the picture be bright. Text laid
           straight onto a photo has to darken whatever happens to be behind
           it, and what is behind it moves with every window size — which is
           why this hero had grown three separate scrims and still measured
           1.87:1 under the headline at some widths. A plate ends that
           argument. The background behind every word is a known colour, so
           contrast is fixed by construction instead of retuned per
           breakpoint, and the photograph gets to keep its own brightness.

           It is flush to the bottom edge of the hero and aligned to the same
           max-w-6xl column as every section below it, so it reads as part of
           the page's structure rather than as a card floating on a picture.
           One bend on the top-right corner, and a hairline that turns that
           corner with it — the move BendRule makes everywhere else here. -->
      <!-- `relative` is load-bearing. The photograph above is absolutely
           positioned, and in the same stacking context a positioned element
           paints over a static one no matter how the source is ordered — so
           without this the picture covers the plate on wide screens, where it
           spans the whole sizer. -->
      <div class="relative mx-auto w-full max-w-6xl px-5 sm:px-8">
        <div
          class="bg-shop/95 border-shop-line bend max-w-[34rem] border-t border-r px-6 pt-8 pb-9 sm:px-9 sm:pt-10 sm:pb-11"
        >
          <!-- The one number that stops people calling, moved above the
               headline and set as a chip rather than as a sentence on a rule
               halfway down the block.

               Sentence case, deliberately. An all-caps eyebrow over a heading
               is the pattern this site avoids everywhere else, and this sits
               in exactly that slot — what keeps it clear of the anti-pattern
               is that it carries a fact rather than a category label, and
               appears once on the site rather than above every heading. -->
          <p
            class="border-shop-line bend mb-5 inline-flex items-baseline gap-2 border px-3 py-1.5"
          >
            <span class="text-steel text-[0.8125rem]">Full cages from</span>
            <span class="font-display text-[0.9375rem] font-bold"
              >{pricing.cageStartingAtDisplay}</span
            >
          </p>

          <!-- The city belongs in the h1, not only in the <title>: "roll
               cages Tucson" is the search this page has to win, and the h1 is
               the strongest on-page signal for it.

               38px, down from 44 and from 72 before that, with the letterfit
               pulled to -0.03em and the leading pinned at 1.02 rather than
               inheriting 1.04. Size alone was never what made this headline
               feel generic — a big sans set loosely is what does that. Tight
               fit and tight leading at a smaller size reads athletic; the
               same words at 44px and -0.02em were drifting toward stock. -->
          <h1
            class="max-w-[18ch] text-[clamp(1.75rem,2.9vw,2.375rem)] leading-[1.02] font-bold tracking-[-0.03em]"
          >
            Custom UTV roll cages in Tucson.
          </h1>

          <!-- steel, not bone. On a known dark ground the documented 5.8:1
               holds, so the secondary line can finally be secondary; it had
               to be full-strength bone before only because it was sitting on
               an unpredictable photograph. -->
          <p class="text-steel mt-4 max-w-[42ch] text-base leading-[1.55]">
            Built by {business.owner}. {
              business.yearsInBusiness.replace(/^over/, 'Over')
            } of it, and he welds every one himself.
          </p>

          <!-- The quote form leads and the phone follows it.

               That is a conversion trade, not only a visual one: the phone is
               how a one-man shop actually books work. What makes it a fair
               trade here is that the number has not gone anywhere — it is in
               the sticky header on every page and in the fixed call/text bar
               at the bottom of every phone screen — while the form is the
               only thing that catches somebody deciding at ten at night.

               On a near-black plate a "dark fill" primary would disappear, so
               the loudest fill available is bone, and the secondary is the
               ghost. Hover steps to bone-lift rather than inverting: a full
               invert on the primary reads as a state change, which is more
               noise than a hover needs to make. -->
          <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:items-center">
            <a
              href="/contact/"
              class="font-display bg-bone text-shop bend hover:bg-bone-lift hover:border-bone-lift border border-bone px-6 py-3.5 text-center font-bold transition-colors"
            >
              Get a quote
            </a>
            <a
              href={phone.tel}
              data-analytics="call-hero"
              /* steel/75, not steel/50. On a ghost button the border IS the
                 control's boundary, so it answers to the 3:1 non-text
                 contrast floor rather than to taste. Against this plate 50%
                 composites to 2.29:1 and 75% to 3.52:1. */
              class="font-display border-steel/75 text-bone bend hover:border-bone hover:bg-bone/5 border px-6 py-3.5 text-center font-bold transition-colors"
            >
              Call {phone.display}
            </a>
          </div>

          <!-- Hours next to the call, not only in the footer. Someone
               deciding to ring a one-man shop needs to know whether anybody
               will pick up. 13px to match the badge: the two tertiary items
               in this block now agree instead of sitting a pixel apart. -->
          <p class="text-steel mt-6 text-[0.8125rem] tracking-[0.01em]">
            {business.hours.display}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ==========================================================
       WHAT HE BUILDS
       One photo and a plain list. The detail lives on /services/.
       ========================================================== -->
  <section class="bg-bone">
    <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-24">
      <BendRule class="mb-8 max-w-xs" />

      <h2 class="max-w-[16ch] text-[clamp(2rem,5vw,3.25rem)]">
        What comes out of the shop
      </h2>

      <!-- One photo and a list, not four photo cards. Each service keeps its
           own heading and anchor on /services/; repeating all four here as
           cards was the single busiest thing on the page. -->
      <div class="mt-12 grid gap-10 lg:grid-cols-2 lg:gap-16">
        <Shot shot="bend-bare" light class="w-full" />

        <div>
          <ul class="border-bone-line border-t">
            {services.map((s) => (
              <li class="border-bone-line border-b">
                <a
                  href={`/services/#${s.slug}`}
                  class="hover:text-slate flex flex-col gap-1.5 py-5 transition-colors"
                >
                  <span class="flex items-baseline justify-between gap-4">
                    <span class="font-display text-xl font-bold">{s.title}</span>
                    {s.startingAt && (
                      <span class="font-display shrink-0 text-lg font-bold">
                        From {s.startingAt}
                      </span>
                    )}
                  </span>
                  <span class="text-slate max-w-[44ch]">{s.blurb}</span>
                </a>
              </li>
            ))}
          </ul>

          <a
            href="/services/"
            class="text-shop mt-6 inline-block font-semibold underline decoration-1 underline-offset-4"
          >
            What goes into each of these
          </a>
        </div>
      </div>
      <p class="text-slate mt-10 max-w-[62ch] text-lg">
        All welding is MIG and done in house. Powder coating is sent out to a
        coater.
      </p>
    </div>
  </section>

  <!-- ==========================================================
       PRICE
       Not knowing what a cage costs is what stops people calling,
       so the number gets a section to itself.
       ========================================================== -->
  <section class="bg-shop text-bone">
    <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-24">
      <div class="grid gap-10 lg:grid-cols-[auto_1fr] lg:gap-16">
        <div>
          <p class="text-steel text-lg">A typical full cage runs</p>
          <p
            class="font-display text-bone mt-1 text-[clamp(4rem,14vw,8rem)] leading-[0.85] font-extrabold tracking-[-0.04em]"
          >
            {pricing.cageStartingAtDisplay}
          </p>
        </div>

        <div class="max-w-[52ch] space-y-5 text-lg">
          <p>
            The price depends on the machine, the seat count, and what else gets
            built while it is apart: doors, a roof, mounts.
          </p>
          <p class="text-steel">
            Call with the year, make and model and you will get a number on the
            phone. You do not need an appointment to ask what something costs.
          </p>
          <p class="text-steel">
            Doors, roofs and custom work are {terms.servicePricing.toLowerCase()}.
            Either way you are not without the machine long — {terms.leadTime.toLowerCase()}.
          </p>
          <p>
            Mike quotes the job and Mike welds it — <a
              href="/about/"
              class="font-semibold underline decoration-1 underline-offset-4"
              >more about the shop</a
            >.
          </p>
          <div class="flex flex-col gap-3 pt-2 sm:flex-row">
            <a
              href={phone.tel}
              data-analytics="call-price"
              class="font-display bg-bone text-shop bend border border-bone hover:bg-transparent hover:text-bone px-6 py-3.5 text-center font-bold transition-colors"
            >
              Call {phone.display}
            </a>
            <a
              href="/contact/"
              class="font-display border-steel/50 bend hover:border-bone border px-6 py-3.5 text-center font-bold transition-colors"
            >
              Send the details
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==========================================================
       GALLERY TEASER — dense, square, no gaps. The camera-roll grid.
       ========================================================== -->
  <section class="bg-bone">
    <div class="mx-auto max-w-6xl px-5 pt-16 sm:px-8 sm:pt-24">
      <BendRule class="mb-8 max-w-xs" />
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <h2 class="text-[clamp(2rem,5vw,3.25rem)]">Machines that have been through</h2>
        <a
          href="/gallery/"
          class="text-shop font-semibold underline decoration-1 underline-offset-4"
        >
          See the full gallery
        </a>
      </div>
      <p class="text-slate mt-4 max-w-[52ch] text-lg">
        {platforms.map((p) => p.name).join(', ')} — and plenty that do not fit a
        category.
      </p>
    </div>

    <!-- Full-bleed, gutterless, square. This is the one dense thing on the
         page and it is meant to read as a wall of work. -->
    <div class="mt-10 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6">
      {teaser.map((photo) => <GalleryTile photo={photo} href="/gallery/" />)}
    </div>
  </section>

  <!-- ==========================================================
       CLOSING CTA
       ========================================================== -->
  <section class="bg-shop text-bone">
    <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-20">
      <h2 class="max-w-[20ch] text-[clamp(2rem,5vw,3.25rem)]">
        Tell me the machine and what you want done.
      </h2>
      <p class="text-steel mt-5 max-w-[48ch] text-lg">
        Year, make and model is enough to start. Photos help if you have them.
      </p>
      <!-- The towns, written out once on the home page in a sentence rather
           than as a keyword list. Somebody in Marana searching for a cage
           needs to see their own town somewhere on the page before they
           believe the shop is close enough to bother with. -->
      <p class="text-steel mt-3 max-w-[48ch] text-lg">
        Machines come in from {business.serviceAreaLine} and the rest of
        southern Arizona.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a
          href={phone.tel}
          data-analytics="call-closing"
          class="font-display bg-bone text-shop bend border border-bone hover:bg-transparent hover:text-bone px-7 py-4 text-center text-lg font-bold transition-colors"
        >
          Call {phone.display}
        </a>
        <a
          href={phone.sms}
          data-analytics="text-closing"
          class="font-display border-steel/50 bend hover:border-bone border px-7 py-4 text-center text-lg font-bold transition-colors"
        >
          Send a text
        </a>
      </div>
    </div>
  </section>
</Base>
