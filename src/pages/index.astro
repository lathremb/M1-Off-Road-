---
import Base from '../layouts/Base.astro';
import Shot from '../components/Shot.astro';
import GalleryTile from '../components/GalleryTile.astro';
import NeedsInput from '../components/NeedsInput.astro';
import BendRule from '../components/BendRule.astro';
import {
  business,
  phone,
  pricing,
  services,
  platforms,
  terms,
} from '../config/site';
import { gallery } from '../config/gallery';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { shots } from '../config/shots';

/* Home is the only page carrying the LocalBusiness block, so the markup
   describes one business rather than eight. */

/* ---------------------------------------------------------
   The hero is generated here rather than through <Shot>, because it is the
   LCP element and has to be preloaded. Building the variants once and using
   the same list for BOTH the preload link and the <img> guarantees they
   match — a preload that misses by one URL downloads the image twice and is
   worse than no preload at all.
   --------------------------------------------------------- */
const heroShot = shots['hero-build'];
const photoFiles = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/photos/*.{jpg,jpeg,png,webp,avif}',
  { eager: true }
);
const heroSource = heroShot.file
  ? photoFiles[`../assets/photos/${heroShot.file}`]?.default
  : undefined;

const HERO_WIDTHS = [640, 960, 1280, 1920, 2560];
const heroVariants = heroSource
  ? await Promise.all(
      HERO_WIDTHS.map((width) =>
        getImage({ src: heroSource, width, format: 'webp', quality: 70 })
      )
    )
  : [];
const heroSrcset = heroVariants
  .map((v, i) => `${v.src} ${HERO_WIDTHS[i]}w`)
  .join(', ');

/* Six tiles for the teaser strip, taken one at a time across the platforms so
   the row is not six near-identical RZRs. */
const teaser = [
  gallery['polaris-rzr'][0],
  gallery['can-am'][0],
  gallery['kawasaki'][0],
  gallery['polaris-rzr'][10],
  gallery['in-the-shop'][0],
  gallery['polaris-rzr'][4],
];
---

<Base
  title="M1 Off-Road — Custom UTV Roll Cages, Doors & Roofs in Tucson"
  description="Custom roll cages, doors and roofs for Polaris RZR, Can-Am and other UTVs. MIG welded in Tucson by Mike Sulger. Full cages start at $2,500. Call (520) 403-3366."
  schema
  preloadImage={heroSrcset ? { srcset: heroSrcset, sizes: '100vw' } : undefined}
>
  <!-- ==========================================================
       HERO — the one place on this site that raises its voice.
       Everything below it is deliberately quiet.
       ========================================================== -->
  <section class="bg-shop text-bone relative">
    <!-- Taller than a typical hero on purpose: the current photograph is
         portrait, and height is what stops a landscape frame from reducing it
         to a letterbox slice. -->
    <div class="relative min-h-[34rem] sm:min-h-[40rem] lg:min-h-[46rem]">
      <!-- The LCP element. Preloaded from the head with this exact srcset. -->
      {
        heroSource ? (
          <img
            src={heroVariants[1]?.src}
            srcset={heroSrcset}
            sizes="100vw"
            alt={heroShot.alt}
            width={heroSource.width}
            height={heroSource.height}
            loading="eager"
            fetchpriority="high"
            decoding="sync"
            class="absolute inset-0 h-full w-full object-cover"
            style={`object-position:${heroShot.position ?? '50% 50%'}`}
          />
        ) : (
          <Shot shot="hero-build" fill eager sizes="100vw" />
        )
      }

      <!-- Scrim. Heavier at the base so the type has something solid to sit on
           without washing the whole photograph out. -->
      <div
        class="absolute inset-0"
        style="background:linear-gradient(to top, rgb(17 17 17 / .94) 0%, rgb(17 17 17 / .78) 38%, rgb(17 17 17 / .30) 72%, rgb(17 17 17 / .10) 100%)"
        aria-hidden="true"
      >
      </div>

      <div
        class="relative mx-auto flex min-h-[34rem] max-w-6xl flex-col justify-end px-5 py-12 sm:min-h-[40rem] sm:px-8 sm:py-16 lg:min-h-[46rem]"
      >
        <h1
          class="max-w-[19ch] text-[clamp(2.5rem,9vw,5rem)] font-extrabold tracking-[-0.03em]"
        >
          Roll cages, doors and roofs, built to your machine.
        </h1>

        <p class="text-steel mt-6 max-w-[46ch] text-lg sm:text-xl">
          MIG welded in {business.city} by {business.owner}, who has been doing
          this {business.yearsInBusiness}. Full cages start at{' '}
          <strong class="text-bone font-semibold"
            >{pricing.cageStartingAtDisplay}</strong
          >.
        </p>

        <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
          <a
            href={phone.tel}
            data-analytics="call-hero"
            class="font-display bg-bone text-shop bend border border-bone hover:bg-transparent hover:text-bone px-7 py-4 text-center text-lg font-bold transition-colors"
          >
            Call {phone.display}
          </a>
          <a
            href="/contact/"
            class="font-display border-steel/50 text-bone bend hover:border-bone border px-7 py-4 text-center text-lg font-bold transition-colors"
          >
            Get a quote
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ==========================================================
       WHAT HE BUILDS
       One photo and a plain list. The detail lives on /services/.
       ========================================================== -->
  <section class="bg-bone">
    <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-24">
      <BendRule class="mb-8 max-w-xs" />

      <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <h2 class="max-w-[16ch] text-[clamp(2rem,5vw,3.25rem)]">
          What comes out of the shop
        </h2>
        <p class="text-slate max-w-[42ch] text-lg">
          Everything is cut, bent and welded for the machine it is going on.
          Nothing here is a kit that gets forced to fit.
        </p>
      </div>

      <!-- One photo and a list, not four photo cards. Each service keeps its
           own heading and anchor on /services/; repeating all four here as
           cards was the single busiest thing on the page. -->
      <div class="mt-12 grid gap-10 lg:grid-cols-2 lg:gap-16">
        <Shot shot="bend-bare" light class="w-full" />

        <div>
          <ul class="border-bone-line border-t">
            {services.map((s) => (
              <li class="border-bone-line border-b">
                <a
                  href={`/services/#${s.slug}`}
                  class="hover:text-slate flex flex-col gap-1.5 py-5 transition-colors"
                >
                  <span class="flex items-baseline justify-between gap-4">
                    <span class="font-display text-xl font-bold">{s.title}</span>
                    {s.startingAt && (
                      <span class="font-display shrink-0 text-lg font-bold">
                        From {s.startingAt}
                      </span>
                    )}
                  </span>
                  <span class="text-slate max-w-[44ch]">{s.blurb}</span>
                </a>
              </li>
            ))}
          </ul>

          <a
            href="/services/"
            class="text-shop mt-6 inline-block font-semibold underline decoration-1 underline-offset-4"
          >
            What goes into each of these
          </a>
        </div>
      </div>
      <!-- The honesty that does more work than any claim would. -->
      <p class="text-slate mt-10 max-w-[62ch] text-lg">
        All the welding is MIG, and all of it happens here. Powder coating goes
        out to a coater — M1 does not do it in house, and you should be
        suspicious of a small shop that says it does everything.
      </p>
    </div>
  </section>

  <!-- ==========================================================
       PRICE
       Not knowing what a cage costs is what stops people calling,
       so the number gets a section to itself.
       ========================================================== -->
  <section class="bg-shop text-bone">
    <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-24">
      <div class="grid gap-10 lg:grid-cols-[auto_1fr] lg:gap-16">
        <div>
          <p class="text-steel text-lg">A typical full cage runs</p>
          <p
            class="font-display text-bone mt-1 text-[clamp(4rem,14vw,8rem)] leading-[0.85] font-extrabold tracking-[-0.04em]"
          >
            {pricing.cageStartingAtDisplay}
          </p>
        </div>

        <div class="max-w-[52ch] space-y-5 text-lg">
          <p>
            That is the real number for a typical full cage, not a teaser. What
            moves it is the machine, the seat count, and what else you want
            built into it while it is apart — doors, a roof, mounts.
          </p>
          <p class="text-steel">
            Call with your year, make and model and you will get a straight
            answer on the phone. No appointment needed to ask what something
            costs.
          </p>
          <p class="text-steel">
            Doors, roofs and custom work are {terms.servicePricing.toLowerCase()}.
            Either way you are not without the machine long — {terms.leadTime.toLowerCase()}.
          </p>
          <p class="text-steel">
            Deposit terms: <NeedsInput key="deposit" dark />
          </p>
          <p>
            You talk to the person doing the welding. That is the whole
            arrangement — <a
              href="/about/"
              class="font-semibold underline decoration-1 underline-offset-4"
              >more about the shop</a
            >.
          </p>
          <div class="flex flex-col gap-3 pt-2 sm:flex-row">
            <a
              href={phone.tel}
              data-analytics="call-price"
              class="font-display bg-bone text-shop bend border border-bone hover:bg-transparent hover:text-bone px-6 py-3.5 text-center font-bold transition-colors"
            >
              Call {phone.display}
            </a>
            <a
              href="/contact/"
              class="font-display border-steel/50 bend hover:border-bone border px-6 py-3.5 text-center font-bold transition-colors"
            >
              Send the details
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==========================================================
       GALLERY TEASER — dense, square, no gaps. The camera-roll grid.
       ========================================================== -->
  <section class="bg-bone">
    <div class="mx-auto max-w-6xl px-5 pt-16 sm:px-8 sm:pt-24">
      <BendRule class="mb-8 max-w-xs" />
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <h2 class="text-[clamp(2rem,5vw,3.25rem)]">Machines that have been through</h2>
        <a
          href="/gallery/"
          class="text-shop font-semibold underline decoration-1 underline-offset-4"
        >
          See the full gallery
        </a>
      </div>
      <p class="text-slate mt-4 max-w-[52ch] text-lg">
        {platforms.map((p) => p.name).join(', ')} — and plenty that do not fit a
        category.
      </p>
    </div>

    <!-- Full-bleed, gutterless, square. This is the one dense thing on the
         page and it is meant to read as a wall of work. -->
    <div class="mt-10 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6">
      {teaser.map((photo) => <GalleryTile photo={photo} />)}
    </div>
  </section>

  <!-- ==========================================================
       CLOSING CTA
       ========================================================== -->
  <section class="bg-shop text-bone">
    <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-20">
      <h2 class="max-w-[20ch] text-[clamp(2rem,5vw,3.25rem)]">
        Tell me the machine and what you want done.
      </h2>
      <p class="text-steel mt-5 max-w-[48ch] text-lg">
        Year, make and model is enough to start. Photos help if you have them.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a
          href={phone.tel}
          data-analytics="call-closing"
          class="font-display bg-bone text-shop bend border border-bone hover:bg-transparent hover:text-bone px-7 py-4 text-center text-lg font-bold transition-colors"
        >
          Call {phone.display}
        </a>
        <a
          href={phone.sms}
          data-analytics="text-closing"
          class="font-display border-steel/50 bend hover:border-bone border px-7 py-4 text-center text-lg font-bold transition-colors"
        >
          Send a text
        </a>
      </div>
    </div>
  </section>
</Base>
