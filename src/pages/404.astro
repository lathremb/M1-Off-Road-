---
import Base from '../layouts/Base.astro';
import BendRule from '../components/BendRule.astro';
import { phone, services } from '../config/site';
---

<Base
  title="Page not found | M1 Off-Road"
  description="That page does not exist. Call M1 Off-Road in Tucson at (520) 403-3366, or start from the roll cages, doors, roofs or custom fabrication pages."
>
  <section class="bg-shop text-bone">
    <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-28">
      <BendRule dark class="mb-8 max-w-[8rem]" />
      <h1 class="max-w-[16ch] text-[clamp(2.25rem,6vw,4rem)] font-extrabold">
        That page is not here
      </h1>
      <p class="text-steel mt-6 max-w-[44ch] text-lg sm:text-xl">
        Nothing dramatic — the link is just wrong. Here is everything the shop
        does.
      </p>

      <ul class="mt-9 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {
          services.map((s) => (
            <li>
              <a
                href={`/${s.slug}/`}
                class="border-shop-line bend hover:border-bone hover:text-bone block border px-5 py-4 font-semibold transition-colors"
              >
                {s.title}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="mt-9 flex flex-col gap-3 sm:flex-row">
        <a
          href={phone.tel}
          data-analytics="call-404"
          class="font-display bg-bone text-shop bend border border-bone hover:bg-transparent hover:text-bone px-7 py-4 text-center text-lg font-bold transition-colors"
        >
          Call {phone.display}
        </a>
        <a
          href="/"
          class="font-display border-steel/50 bend hover:border-bone border px-7 py-4 text-center text-lg font-bold transition-colors"
        >
          Back to the start
        </a>
      </div>
    </div>
  </section>
</Base>
