---
/**
 * Shared frame for the four service pages: a dark masthead, the page body,
 * then a consistent close. The body is the page's own — this only owns the
 * parts that should be identical everywhere, so no two service pages read
 * like the same page with the nouns swapped.
 */
import Base from './Base.astro';
import Shot from '../components/Shot.astro';
import BendRule from '../components/BendRule.astro';
import { phone, services, pricing } from '../config/site';
import type { ShotKey } from '../config/shots';

interface Props {
  title: string;
  description: string;
  /** Which service this is, so the page can exclude itself from the footer list. */
  slug: string;
  /** The h1. Written per page. */
  headline: string;
  lede: string;
  heroShot: ShotKey;
  /** Shown under the lede when there is a confirmed price. */
  price?: string;
}

const { title, description, slug, headline, lede, heroShot, price } =
  Astro.props;

const others = services.filter((s) => s.slug !== slug);
---

<Base title={title} description={description}>
  <section class="bg-shop text-bone">
    <div
      class="mx-auto grid max-w-6xl items-center gap-10 px-5 py-14 sm:px-8 sm:py-20 lg:grid-cols-2 lg:gap-16"
    >
      <div>
        <BendRule dark class="mb-8 max-w-[8rem]" />
        <h1 class="max-w-[16ch] text-[clamp(2.25rem,6vw,4rem)] font-extrabold">
          {headline}
        </h1>
        <p class="text-steel mt-6 max-w-[46ch] text-lg sm:text-xl">{lede}</p>

        {
          price && (
            <p class="font-display mt-6 text-2xl font-bold">
              From <span class="text-bone">{price}</span>
            </p>
          )
        }

        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a
            href={phone.tel}
            data-analytics={`call-${slug}`}
            class="font-display bg-bone text-shop bend border border-bone hover:bg-transparent hover:text-bone px-6 py-3.5 text-center font-bold transition-colors"
          >
            Call {phone.display}
          </a>
          <a
            href="/contact/"
            class="font-display border-steel/50 bend hover:border-bone border px-6 py-3.5 text-center font-bold transition-colors"
          >
            Get a quote
          </a>
        </div>
      </div>

      <Shot shot={heroShot} class="w-full" />
    </div>
  </section>

  <slot />

  <!-- Close: price reminder, then the other three services. -->
  <section class="bg-bone">
    <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-20">
      <div
        class="border-bone-line bend flex flex-col gap-6 border p-6 sm:p-10 lg:flex-row lg:items-center lg:justify-between"
      >
        <div>
          <h2 class="text-[clamp(1.75rem,4vw,2.5rem)]">
            Call with the year, make and model
          </h2>
          <p class="text-slate mt-3 max-w-[48ch] text-lg">
            That is enough to get a straight number. Full cages start at {
              pricing.cageStartingAtDisplay
            }.
          </p>
        </div>
        <div class="flex shrink-0 flex-col gap-3 sm:flex-row">
          <a
            href={phone.tel}
            data-analytics={`call-${slug}-footer`}
            class="font-display bg-shop bend border border-shop px-6 py-3.5 text-center font-bold text-bone transition-colors hover:bg-transparent hover:text-shop"
          >
            {phone.display}
          </a>
          <a
            href={phone.sms}
            data-analytics={`text-${slug}-footer`}
            class="font-display border-bone-line bend hover:border-shop border px-6 py-3.5 text-center font-bold transition-colors"
          >
            Send a text
          </a>
        </div>
      </div>

      <h2 class="mt-16 text-2xl">Also out of this shop</h2>
      <ul class="mt-6 grid gap-4 sm:grid-cols-3">
        {
          others.map((s) => (
            <li class="border-bone-line bend border p-5">
              <h3 class="text-xl">
                <a href={`/${s.slug}/`} class="hover:text-slate transition-colors">
                  {s.title}
                </a>
              </h3>
              <p class="text-slate mt-2 text-[0.9375rem]">{s.blurb}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>
