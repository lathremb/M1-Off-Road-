---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyBar from '../components/StickyBar.astro';
import Schema from '../components/Schema.astro';
import Analytics from '../components/Analytics.astro';
import { business, indexable } from '../config/site';

interface Props {
  /** Unique per page. Written in full — no automatic suffix, so every one was
      actually thought about rather than generated. Keep under ~60 characters. */
  title: string;
  /** Unique per page, 140–160 characters. */
  description: string;
  /**
   * Emit the LocalBusiness block. The home page only — it is the whole site
   * now, and 404 has no business being described as one.
   */
  schema?: boolean;
  /**
   * srcset for the page's LCP image, so it can be preloaded.
   *
   * Without this the browser cannot discover the hero until the stylesheet
   * has resolved and layout has run — which on a throttled mobile connection
   * is two extra round trips and roughly a second of LCP. The bytes were
   * never the problem; the discovery time was.
   */
  /**
   * One entry, or one per art-directed crop. When the hero serves a different
   * photograph per breakpoint, each needs its own preload carrying the same
   * `media` as its <source> — otherwise only the crop that happens to be
   * listed gets the head start, and the other breakpoint discovers its hero
   * the slow way.
   */
  preloadImage?:
    | { srcset: string; sizes: string; media?: string }
    | { srcset: string; sizes: string; media?: string }[];
}

const { title, description, schema = false, preloadImage } = Astro.props;
const preloads = preloadImage
  ? (Array.isArray(preloadImage) ? preloadImage : [preloadImage]).filter(
      (p) => p?.srcset
    )
  : [];
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Nothing gets indexed until SITE_LIVE is flipped in src/config/site.ts
         AND this is a production deploy. Keeps the placeholder site out of
         search results while it is being finished. -->
    {!indexable && <meta name="robots" content="noindex, nofollow" />}

    <!-- The only font on the site. Preloaded because the headline is the
         first thing that paints. -->
    <link
      rel="preload"
      href="/fonts/archivo-latin-wght.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {
      preloads.map((p) => (
        <link
          rel="preload"
          as="image"
          imagesrcset={p.srcset}
          imagesizes={p.sizes}
          media={p.media}
          fetchpriority="high"
        />
      ))
    }

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#111111" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="M1 Off-Road" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <!-- og:image is intentionally absent until there is a real share image: a
         card pointing at a placeholder is worse than no card at all. The slot
         is reserved in the shot list — reserved-shot: og-share

         The card type follows from that. `summary_large_image` promises an
         image and there is none, so it degrades to a blank panel; `summary`
         is what this actually is until the share photo exists. Change both
         together. -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Legacy geo meta. No search engine weights these any more, but they
         cost nothing and some directory scrapers still read them. -->
    <meta name="geo.region" content="US-AZ" />
    <meta name="geo.placename" content="Tucson" />
    {
      business.geo && (
        <>
          <meta
            name="geo.position"
            content={`${business.geo.lat};${business.geo.lng}`}
          />
          <meta
            name="ICBM"
            content={`${business.geo.lat}, ${business.geo.lng}`}
          />
        </>
      )
    }

    {schema && <Schema />}
    <Analytics />
  </head>

  <body>
    <a
      href="#main"
      class="focus:bg-shop focus:text-bone sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-[60] focus:px-4 focus:py-2"
      >Skip to content</a
    >

    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <StickyBar />
  </body>
</html>
