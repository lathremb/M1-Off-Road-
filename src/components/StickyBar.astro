---
/**
 * Call and text, side by side, pinned to the bottom of the mobile viewport.
 *
 * Two equal 50/50 targets. Hidden from md up, where the header already
 * carries the number. `body` reserves matching padding in global.css so this
 * never covers the end of a page.
 */
import { phone } from '../config/site';
---

<div
  class="border-shop-line bg-shop fixed inset-x-0 bottom-0 z-50 grid grid-cols-2 border-t md:hidden"
  style="padding-bottom:env(safe-area-inset-bottom,0px)"
>
  <a
    href={phone.tel}
    data-analytics="call-sticky"
    class="border-shop-line text-bone flex items-center justify-center gap-2 border-r py-4 text-[0.9375rem] font-semibold"
  >
    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <path
        d="M14.5 11.3v2a1.3 1.3 0 0 1-1.5 1.3 13 13 0 0 1-5.6-2 12.7 12.7 0 0 1-4-4 13 13 0 0 1-2-5.7A1.3 1.3 0 0 1 2.7 1.5h2a1.3 1.3 0 0 1 1.3 1.1c.1.7.3 1.3.5 1.9a1.3 1.3 0 0 1-.3 1.4l-.8.8a10.7 10.7 0 0 0 4 4l.8-.8a1.3 1.3 0 0 1 1.4-.3c.6.2 1.2.4 1.9.5a1.3 1.3 0 0 1 1 1.2Z"
        stroke="currentColor"
        stroke-width="1.4"
        stroke-linejoin="round"></path>
    </svg>
    Call
  </a>

  <a
    href={phone.sms}
    data-analytics="text-sticky"
    class="text-shop bg-flare flex items-center justify-center gap-2 py-4 text-[0.9375rem] font-semibold"
  >
    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <path
        d="M14.5 10a1.5 1.5 0 0 1-1.5 1.5H4.5L1.5 14.5V3A1.5 1.5 0 0 1 3 1.5h10A1.5 1.5 0 0 1 14.5 3Z"
        stroke="currentColor"
        stroke-width="1.4"
        stroke-linejoin="round"></path>
    </svg>
    Text
  </a>
</div>
