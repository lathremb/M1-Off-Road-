---
/**
 * A visible marker where a fact would go.
 *
 * The brief was explicit that nothing gets invented — no tubing spec, no lead
 * time, no address, no review count. Where a page wanted one of those, this
 * renders in its place. It is meant to be seen: a reviewer should be able to
 * scan a page and find every hole in it without opening a document.
 *
 * Keys come from src/config/needs-input.ts, and the build fails if a key here
 * does not exist in that file.
 */
import { gaps, type GapKey } from '../config/needs-input';

interface Props {
  key: GapKey;
  /** Light grounds are the default; set for sections on shop black. */
  dark?: boolean;
  /** Renders as a block with its own line rather than inline in a sentence. */
  block?: boolean;
}

const { key, dark = false, block = false } = Astro.props;
const gap = gaps[key];

/* Only launch-blocking gaps are allowed to render.

   A `content` gap means "the site works, this page is just thinner" — by its
   own definition it is not worth showing a visitor a hole. One of them
   (deposit terms) was rendering on the home page three sentences after the
   most reassuring line on the site, while two others of the same severity
   were quietly omitted. The registry stayed the source of truth either way;
   the pages disagreed with it. This makes the rule structural instead of
   something each page has to remember. Every gap still appears in
   NEEDS-INPUT.md. */
const visible = gap.severity === 'launch';
---

{
  visible && (
    <span
      class:list={[
        'font-mono text-[0.75rem] leading-normal tracking-tight',
        'border border-dashed px-1.5 py-0.5 align-baseline',
        block ? 'inline-block' : 'inline',
        dark ? 'border-steel/60 text-bone' : 'border-slate/60 text-shop',
      ]}
      title={gap.why}
    >
      [ needs input — {gap.label} ]
    </span>
  )
}
