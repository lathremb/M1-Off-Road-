---
import Logo from './Logo.astro';
import NeedsInput from './NeedsInput.astro';
import { business, phone, services, pricing } from '../config/site';

const year = new Date().getFullYear();
---

<footer class="bg-shop text-steel">
  <div class="mx-auto max-w-6xl px-5 py-14 sm:px-8 sm:py-16">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div class="lg:col-span-2">
        <div class="text-bone">
          <Logo />
        </div>
        <p class="mt-4 max-w-sm text-[0.9375rem]">
          Custom fabrication for off-road machines. Roll cages, doors and roofs,
          MIG welded in {business.city}, {business.stateCode} by {business.owner}.
        </p>
        <p class="mt-4 text-[0.9375rem]">
          <a
            href={phone.tel}
            data-analytics="call-footer"
            class="font-display text-bone hover:text-bone text-xl font-bold transition-colors"
          >
            {phone.display}
          </a>
        </p>
        <p class="mt-1 text-sm">
          Full cages start at {pricing.cageStartingAtDisplay}.
        </p>
      </div>

      <nav aria-label="Services">
        <h2 class="text-bone text-sm font-semibold">What we build</h2>
        <ul class="mt-3 space-y-2 text-[0.9375rem]">
          {
            services.map((s) => (
              <li>
                <a
                  href={`/services/#${s.slug}`}
                  class="hover:text-bone transition-colors"
                >
                  {s.title}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <h2 class="text-bone text-sm font-semibold">Shop</h2>
        <ul class="mt-3 space-y-2 text-[0.9375rem]">
          <li><a href="/gallery/" class="hover:text-bone transition-colors">Gallery</a></li>
          <li><a href="/about/" class="hover:text-bone transition-colors">About</a></li>
          <li><a href="/contact/" class="hover:text-bone transition-colors">Contact</a></li>
          <li>
            {
              business.facebook ? (
                <a
                  href={business.facebook}
                  rel="noopener"
                  class="hover:text-bone transition-colors"
                >
                  Facebook
                </a>
              ) : (
                <NeedsInput key="facebook" dark />
              )
            }
          </li>
        </ul>

        <h2 class="text-bone mt-6 text-sm font-semibold">Find us</h2>
        <p class="mt-3 text-[0.9375rem]">{business.city}, {business.stateCode}</p>
        <p class="mt-2"><NeedsInput key="address" dark /></p>
        <p class="mt-2"><NeedsInput key="hours" dark /></p>
      </div>
    </div>

    <div
      class="border-shop-line mt-12 flex flex-col gap-2 border-t pt-6 text-sm sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {year} {business.name}. {business.owner}, owner.</p>
      <p>Custom fabrication · {business.city}, {business.stateCode}</p>
    </div>
  </div>
</footer>
