---
/**
 * Click-to-enlarge for the gallery.
 *
 * Built on <dialog showModal()>, which gets Escape-to-close, the top layer,
 * focus containment and inertness on the rest of the page from the platform
 * rather than from script. What is left is small: set the image, move between
 * photos, restore focus.
 *
 * The enlarged file is only requested when a tile is opened, so the page cost
 * of having a lightbox at all is one dialog element and roughly 40 lines.
 */
---

<dialog
  id="lightbox"
  class="bg-shop/0 max-h-none max-w-none p-0 backdrop:bg-black/85"
  aria-label="Enlarged photo"
>
  <div class="fixed inset-0 flex flex-col">
    <div class="flex shrink-0 items-center justify-between gap-4 px-4 py-3">
      <p
        id="lightbox-count"
        class="text-steel font-mono text-sm tabular-nums"
        aria-live="polite"
      >
      </p>
      <button
        type="button"
        id="lightbox-close"
        class="text-bone hover:border-bone border border-transparent p-2 transition-colors"
      >
        <span class="sr-only">Close</span>
        <svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
          <path d="M3 3l16 16M19 3L3 19" stroke="currentColor" stroke-width="1.6"></path>
        </svg>
      </button>
    </div>

    <div class="flex min-h-0 flex-1 items-center justify-center px-2 pb-2">
      <img id="lightbox-img" src="" alt="" class="max-h-full max-w-full object-contain" />
    </div>

    <div class="flex shrink-0 items-center justify-between gap-4 px-4 py-3">
      <button
        type="button"
        id="lightbox-prev"
        class="text-bone border-shop-line hover:border-bone bend border px-4 py-2.5 text-[0.9375rem] font-semibold transition-colors"
      >
        Previous
      </button>
      <p id="lightbox-caption" class="text-steel hidden max-w-[46ch] text-sm sm:block"></p>
      <button
        type="button"
        id="lightbox-next"
        class="text-bone border-shop-line hover:border-bone bend border px-4 py-2.5 text-[0.9375rem] font-semibold transition-colors"
      >
        Next
      </button>
    </div>
  </div>
</dialog>

<script>
  const dialog = document.getElementById('lightbox') as HTMLDialogElement | null;
  const img = document.getElementById('lightbox-img') as HTMLImageElement | null;
  const caption = document.getElementById('lightbox-caption');
  const count = document.getElementById('lightbox-count');
  const tiles = Array.from(
    document.querySelectorAll<HTMLButtonElement>('[data-lightbox]')
  );

  if (dialog && img && tiles.length) {
    let current = 0;
    let opener: HTMLElement | null = null;

    const show = (i: number) => {
      current = (i + tiles.length) % tiles.length;
      const tile = tiles[current];
      img.src = tile.dataset.full ?? '';
      img.alt = tile.dataset.alt ?? '';
      if (caption) caption.textContent = tile.dataset.alt ?? '';
      if (count) count.textContent = `${current + 1} / ${tiles.length}`;
    };

    tiles.forEach((tile, i) =>
      tile.addEventListener('click', () => {
        opener = tile;
        show(i);
        dialog.showModal();
      })
    );

    document.getElementById('lightbox-close')?.addEventListener('click', () => dialog.close());
    document.getElementById('lightbox-prev')?.addEventListener('click', () => show(current - 1));
    document.getElementById('lightbox-next')?.addEventListener('click', () => show(current + 1));

    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); show(current + 1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); show(current - 1); }
    });

    // Clicking the backdrop closes. The dialog fills the viewport, so compare
    // against the element the press actually landed on.
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });

    // Send focus back to the tile that opened it, not to the top of the page.
    dialog.addEventListener('close', () => {
      opener?.focus();
      img.src = '';
    });
  }
</script>
