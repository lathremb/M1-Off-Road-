---
/**
 * The M1 Off-Road lockup.
 *
 * ⚠ THIS IS A WORDMARK, NOT THE REAL MARK.
 *
 * An earlier version of this file carried a hand-traced five-point star. Once
 * high-resolution photographs of the badge arrived it was clear that guess was
 * wrong in the way that matters: the actual mark is a star with a stylised
 * "M1" locked into it, where the 1 is rendered as a waving American flag —
 * star field at the top, stripes running down — with "OFF-ROAD" set small and
 * running diagonally across the lower left.
 *
 * That is a three-element interlocking mark. Redrawing it from a photograph
 * would produce something that reads as a poor copy of Mike's logo rather than
 * his logo, which is worse than not showing it at all. So the mark is left out
 * and the wordmark carries the header until the original artwork turns up.
 *
 * See `detail-badge-white-cage.jpg` and `detail-badge-bronze-cage.jpg` in
 * src/assets/photos/ for the clearest views of it. [needs-input: logo-art]
 */
interface Props {
  /** Reserved for when the real mark exists — currently renders nothing. */
  markOnly?: boolean;
  class?: string;
}

const { markOnly = false, class: className = '' } = Astro.props;
---

<span class:list={['inline-flex items-center gap-2.5', className]}>
  {
    markOnly ? (
      <span class="font-display text-[1.0625rem] leading-none font-extrabold tracking-[-0.02em]">
        M1
      </span>
    ) : (
      <span class="font-display text-[1.0625rem] leading-none font-extrabold tracking-[-0.015em] sm:text-lg">
        M1 <span class="font-semibold">OFF-ROAD</span>
      </span>
    )
  }
  <span class="sr-only">M1 Off-Road</span>
</span>
