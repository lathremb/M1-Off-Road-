---
import Logo from './Logo.astro';
import { phone, services } from '../config/site';

/* Sticky, so the number and the nav are reachable from anywhere on the page
   rather than only from the top of it. The gallery is long and /services/ is
   longer; having to scroll back up to call was the cost of a static bar.

   `sticky`, not `fixed`: it stays in normal flow, so nothing underneath has
   to reserve space for it and there is no layout shift on load. The mobile
   call/text bar at the bottom IS fixed, and `body` pads for that one.

   Two bars on a phone is the trade. It costs about 68px at the top on top of
   the 68px already spent at the bottom; the header carries only the wordmark
   and the menu button under md, so that is the whole price.

   Anchors are handled by `scroll-padding-top` on `html` in global.css — a
   section linked as #roofs would otherwise land underneath this. */

/* Four sections of one page, not four pages.

   There is deliberately no aria-current here any more. It marked the page you
   were on, and on a single-page site every one of these is the page you are
   on, so marking one would be a lie and marking all four would be noise.
   Doing it honestly means scroll-spying the sections and moving the mark as
   you scroll, which is a lot of script for a four-item bar. */
const nav = [
  { href: '#what-we-build', label: 'What We Build' },
  { href: '#gallery', label: 'Gallery' },
  { href: '#about', label: 'About' },
  { href: '#contact', label: 'Contact' },
];
---

<!-- z-40 sits under the skip link (z-60) and the mobile call bar (z-50).
     Neither overlaps this one, but the order matters if any of them ever
     grows. The background is solid, not translucent: this bar spends most of
     its life over the hero photograph. -->
<header class="bg-shop text-bone sticky top-0 z-40">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-4 sm:px-8">
    <a
      href="/"
      class="text-bone transition-colors hover:text-bone"
      aria-label="M1 Off-Road — home"
    >
      <Logo />
    </a>

    <!-- Desktop navigation -->
    <nav class="hidden md:block" aria-label="Main">
      <ul class="flex items-center gap-6 lg:gap-7">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="text-steel hover:text-bone text-[0.9375rem] transition-colors"
              >
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <a
            href={phone.tel}
            data-analytics="call-header"
            class="font-display bg-bone text-shop border border-bone hover:bg-transparent hover:text-bone bend px-4 py-2 text-[0.9375rem] font-bold transition-colors"
          >
            {phone.display}
          </a>
        </li>
      </ul>
    </nav>

    <!-- Mobile menu toggle. Call and text live in the sticky bar below, so
         this button only has to open navigation. -->
    <button
      type="button"
      id="nav-toggle"
      class="border-shop-line text-bone hover:border-bone -mr-1 border p-2.5 transition-colors md:hidden"
      aria-expanded="false"
      aria-controls="nav-mobile"
    >
      <span class="sr-only">Menu</span>
      <svg width="20" height="14" viewBox="0 0 20 14" fill="none" aria-hidden="true">
        <path d="M0 1h20M0 7h20M0 13h20" stroke="currentColor" stroke-width="1.5"></path>
      </svg>
    </button>
  </div>

  <nav id="nav-mobile" class="border-shop-line hidden border-t md:hidden" aria-label="Main">
    <ul class="mx-auto max-w-6xl px-5 py-2 sm:px-8">
      {
        nav.map((item) => (
          <li class="border-shop-line/60 border-b last:border-0">
            <a href={item.href} class="text-bone block py-3.5 text-[0.9375rem]">
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('nav-mobile');

  const setOpen = (open: boolean) => {
    toggle?.setAttribute('aria-expanded', String(open));
    menu?.classList.toggle('hidden', !open);
  };

  toggle?.addEventListener('click', () => {
    setOpen(toggle.getAttribute('aria-expanded') !== 'true');
  });

  /* Close on choosing a destination.

     This became necessary when the site became one page. Every one of these
     used to be a navigation, and the new document arrived with the menu shut
     because it was a new document. They are same-page anchors now: the menu
     stays open over the very section it just scrolled to, which on a phone
     means the answer is behind the thing that asked the question. */
  menu?.querySelectorAll('a').forEach((link) =>
    link.addEventListener('click', () => setOpen(false))
  );
</script>
